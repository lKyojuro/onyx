import { OnyxTheme } from "../tokens.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

// Crisp geometric Onyx emblem in luminous violet-indigo crystal aesthetic
export component OnyxEmblem inherits Rectangle {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: @linear-gradient(145deg, #24204a 0%, #110f28 55%, #070614 100%);
    border-width: 1px;
    border-color: OnyxTheme.dark-mode ? #b4aaff44 : #6256d655;

    Path {
        x: 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #191638;
        stroke: OnyxTheme.accent-bright;
        stroke-width: 1.6px;

        MoveTo { x: 12; y: 2; }
        LineTo { x: 20.5; y: 7; }
        LineTo { x: 20.5; y: 17; }
        LineTo { x: 12; y: 22; }
        LineTo { x: 3.5; y: 17; }
        LineTo { x: 3.5; y: 7; }
        Close { }
    }

    Rectangle {
        x: 9.5px;
        y: 9.5px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: OnyxTheme.accent-bright;
    }
}

// Subtle 1px divider (vertical)
export component VerticalDivider inherits Rectangle {
    width: 1px;
    height: 18px;
    background: OnyxTheme.border-subtle;
}

// Subtle 1px divider (horizontal)
export component HorizontalDivider inherits Rectangle {
    height: 1px;
    background: OnyxTheme.border-subtle;
}

// Fluent / Nocturne toolbar & navigation button with Lucide-style vector icon support
export component FluentButton inherits Rectangle {
    in property <string> icon-name: "";
    in property <string> trailing-icon: "";
    in property <string> label: "";
    in property <string> a11y-label: label != "" ? label : icon-name;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <length> min-btn-width: compact ? 28px : 30px;

    callback clicked();

    property <color> fg-color: !root.enabled
        ? OnyxTheme.text-muted
        : root.primary
            ? (root.danger ? #ffffff : OnyxTheme.text-on-accent)
            : root.danger && ta.has-hover
                ? OnyxTheme.danger
                : root.active
                    ? OnyxTheme.accent-bright
                    : OnyxTheme.text-primary;

    height: compact ? 26px : 28px;
    min-width: min-btn-width;
    border-radius: OnyxTheme.radius-sm;
    border-width: (active || primary) ? 1px : 0px;
    border-color: primary
        ? (danger ? OnyxTheme.danger : OnyxTheme.accent-border)
        : (active ? OnyxTheme.accent-border : transparent);

    background: !enabled
        ? transparent
        : primary
            ? (danger
                ? (ta.pressed ? OnyxTheme.danger-hover : (ta.has-hover ? OnyxTheme.danger-hover : OnyxTheme.danger))
                : (ta.pressed ? OnyxTheme.accent-effective.darker(14%) : (ta.has-hover ? OnyxTheme.accent-effective.brighter(8%) : OnyxTheme.accent-effective)))
            : danger && ta.has-hover
                ? OnyxTheme.danger-bg
                : active
                    ? (ta.has-hover ? OnyxTheme.accent-subtle.brighter(12%) : OnyxTheme.accent-subtle)
                    : (ta.pressed ? OnyxTheme.bg-pressed : (ta.has-hover ? OnyxTheme.bg-hover : transparent));

    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: root.label != "" ? (root.compact ? 8px : 10px) : 6px;
        padding-right: root.label != "" ? (root.compact ? 8px : 10px) : 6px;
        spacing: 5px;
        alignment: center;

        if root.icon-name != "" : VerticalLayout {
            alignment: center;
            OnyxIcon {
                name: root.icon-name;
                icon-color: root.fg-color;
                opacity: root.enabled ? 1.0 : 0.38;
            }
        }

        if root.label != "" : Text {
            text: root.label;
            font-size: OnyxTheme.font-sm;
            font-weight: (root.active || root.primary) ? 600 : 400;
            vertical-alignment: center;
            color: root.fg-color;
            opacity: root.enabled ? 1.0 : 0.38;
        }

        if root.trailing-icon != "" : VerticalLayout {
            alignment: center;
            OnyxIcon {
                name: root.trailing-icon;
                size: OnyxIconSize.small;
                icon-color: root.fg-color;
                opacity: root.enabled ? 1.0 : 0.38;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Small pill badge (non-interactive or toggle chip)
export component FluentChip inherits Rectangle {
    in property <string> label: "";
    in property <string> a11y-label: label;
    in property <bool> active: false;
    in property <bool> interactive: true;

    callback clicked();

    height: 22px;
    border-radius: OnyxTheme.radius-sm;
    border-width: 1px;
    border-color: active ? OnyxTheme.accent-border : OnyxTheme.border-subtle;
    background: active
        ? OnyxTheme.accent-subtle
        : (interactive && ta.has-hover ? OnyxTheme.bg-hover : OnyxTheme.bg-badge);

    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-enabled: root.interactive;

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        alignment: center;

        Text {
            text: root.label;
            font-size: OnyxTheme.font-xs;
            font-weight: root.active ? 600 : 500;
            color: root.active ? OnyxTheme.accent-bright : OnyxTheme.text-secondary;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
}
