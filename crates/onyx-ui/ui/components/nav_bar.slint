import { LineEdit } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiBreadcrumb } from "../types.slint";
import { FluentButton, FluentChip } from "common.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

export component NavBar inherits Rectangle {
    in property <int> active-pane: 0;
    in property <[UiBreadcrumb]> breadcrumbs;
    in-out property <string> address-text: "";
    in-out property <bool> address-editing: false;
    in-out property <[string]> address-suggestions;
    in-out property <int> suggestion-index: -1;
    out property <length> address-bar-x: address-box.absolute-position.x;
    out property <length> address-bar-y: address-box.absolute-position.y + address-box.height + 4px;
    out property <length> address-bar-width: address-box.width;
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-current-favorite: false;
    in-out property <string> search-text: "";
    in property <bool> indexed-search: false;

    callback nav-back();
    callback nav-forward();
    callback nav-up();
    callback nav-refresh();
    callback navigate-to(int, string);
    callback submit-address(string);
    callback address-edited(string);
    callback address-suggestion-accepted(string);
    callback search-changed(string);
    callback search-submitted(string);
    callback toggle-indexed-search();
    callback toggle-favorite();
    callback focus-main();

    public function focus-address-bar() {
        root.address-editing = true;
        address-input.focus();
    }

    changed address-editing => {
        if !root.address-editing {
            root.address-suggestions = [];
            suggestion-index = -1;
        }
    }

    changed address-suggestions => {
        suggestion-index = -1;
    }

    public function focus-search-bar() {
        search-input.focus();
    }

    height: 44px;
    background: OnyxTheme.bg-chrome;

    // Subtle bottom hairline
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: OnyxTheme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;
        alignment: stretch;

        // Navigation buttons
        HorizontalLayout {
            spacing: 2px;
            horizontal-stretch: 0;

            FluentButton {
                icon-name: "back";
                a11y-label: "Back";
                enabled: root.can-go-back;
                clicked => { root.nav-back(); }
            }

            FluentButton {
                icon-name: "forward";
                a11y-label: "Forward";
                enabled: root.can-go-forward;
                clicked => { root.nav-forward(); }
            }

            FluentButton {
                icon-name: "up";
                a11y-label: "Up one level";
                clicked => { root.nav-up(); }
            }

            FluentButton {
                icon-name: "refresh";
                a11y-label: "Refresh";
                clicked => { root.nav-refresh(); }
            }
        }

        // Breadcrumbs / Editable Address Bar
        address-box := Rectangle {
            horizontal-stretch: 1;
            min-width: 240px;
            height: 32px;
            border-radius: OnyxTheme.radius-md;
            border-width: 1px;
            border-color: root.address-editing ? OnyxTheme.border-focus : OnyxTheme.border-subtle;
            background: OnyxTheme.bg-input;

            animate border-color { duration: 120ms; }

            if !root.address-editing : HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 2px;

                // Clickable breadcrumb segments
                for crumb[idx] in root.breadcrumbs : HorizontalLayout {
                    spacing: 2px;
                    horizontal-stretch: 0;

                    if idx > 0 : VerticalLayout {
                        alignment: center;
                        OnyxIcon {
                            name: "chevron-right";
                            size: OnyxIconSize.small;
                            icon-color: OnyxTheme.text-muted;
                        }
                    }

                    Rectangle {
                        height: 24px;
                        y: 4px;
                        border-radius: OnyxTheme.radius-sm;
                        background: crumb-ta.has-hover ? OnyxTheme.bg-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Navigate to " + crumb.label;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;

                            Text {
                                text: crumb.label;
                                font-size: OnyxTheme.font-sm;
                                font-weight: idx == root.breadcrumbs.length - 1 ? 600 : 400;
                                color: idx == root.breadcrumbs.length - 1 ? OnyxTheme.text-primary : OnyxTheme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        crumb-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.navigate-to(root.active-pane, crumb.path); }
                        }
                    }
                }

                // Empty space click enters editable address mode
                Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: "Edit address bar";

                    TouchArea {
                        mouse-cursor: text;
                        clicked => {
                            root.address-editing = true;
                            address-input.focus();
                        }
                    }
                }

                // Pin / unpin favorite button inside address bar
                Rectangle {
                    width: 24px;
                    height: 24px;
                    y: 4px;
                    border-radius: OnyxTheme.radius-sm;
                    background: fav-ta.has-hover ? OnyxTheme.bg-hover : transparent;
                    accessible-role: button;
                    accessible-label: root.is-current-favorite ? "Remove folder from favorites" : "Pin folder to favorites";

                    OnyxIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        name: root.is-current-favorite ? "star-filled" : "star";
                        icon-color: root.is-current-favorite ? OnyxTheme.accent-bright : OnyxTheme.text-muted;
                    }

                    fav-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-favorite(); }
                    }
                }
            }

            // Editable Address Bar LineEdit
            addr-scope := FocusScope {
                visible: root.address-editing;
                width: parent.width;
                height: parent.height;

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.address-editing = false;
                        root.focus-main();
                        return accept;
                    }
                    if root.address-suggestions.length > 0 {
                        if event.text == Key.DownArrow {
                            suggestion-index = Math.min(suggestion-index + 1, root.address-suggestions.length - 1);
                            return accept;
                        }
                        if event.text == Key.UpArrow {
                            suggestion-index = Math.max(suggestion-index - 1, 0);
                            return accept;
                        }
                        if event.text == Key.Tab {
                            if suggestion-index < 0 {
                                suggestion-index = 0;
                            }
                            root.address-suggestion-accepted(root.address-suggestions[suggestion-index]);
                            return accept;
                        }
                    }
                    return reject;
                }

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 4px;

                    address-input := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.address-text;
                        placeholder-text: "Enter path and press Enter...";
                        font-size: OnyxTheme.font-md;
                        edited(text) => { root.address-edited(text); }
                        accepted(text) => {
                            root.address-editing = false;
                            root.submit-address(text);
                            root.focus-main();
                        }
                    }
                }
            }
        }

        // Search Bar
        Rectangle {
            width: 280px;
            horizontal-stretch: 0;
            height: 32px;
            border-radius: OnyxTheme.radius-md;
            border-width: 1px;
            border-color: search-input.has-focus ? OnyxTheme.border-focus : OnyxTheme.border-subtle;
            background: OnyxTheme.bg-input;

            animate border-color { duration: 120ms; }

            search-scope := FocusScope {
                width: parent.width;
                height: parent.height;

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        if root.search-text != "" {
                            root.search-text = "";
                            root.search-changed("");
                        }
                        root.focus-main();
                        return accept;
                    }
                    return reject;
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 5px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 5px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        OnyxIcon {
                            name: "search";
                            icon-color: OnyxTheme.text-muted;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 1px;
                        clip: true;

                        ContextMenuArea {
                            Menu {
                                MenuItem { title: @tr("Undo"); activated => { search-input.undo(); } }
                                MenuItem { title: @tr("Redo"); activated => { search-input.redo(); } }
                                MenuSeparator {}
                                MenuItem {
                                    title: @tr("Cut");
                                    enabled: search-input.has-selection;
                                    activated => { search-input.cut(); }
                                }
                                MenuItem {
                                    title: @tr("Copy");
                                    enabled: search-input.has-selection;
                                    activated => { search-input.copy(); }
                                }
                                MenuItem { title: @tr("Paste"); activated => { search-input.paste(); } }
                                MenuItem {
                                    title: @tr("Select All");
                                    enabled: root.search-text != "";
                                    activated => { search-input.select-all(); }
                                }
                            }
                        }

                        search-input := TextInput {
                            property <length> scroll-x: 0px;

                            x: clamp(scroll-x, parent.width - self.width, 0px);
                            width: max(parent.width, self.preferred-width + self.text-cursor-width);
                            height: parent.height;
                            text <=> root.search-text;
                            single-line: true;
                            vertical-alignment: center;
                            font-size: OnyxTheme.font-md;
                            color: OnyxTheme.text-primary;
                            accessible-label: root.indexed-search ? "Search index" : "Filter folder";
                            cursor-position-changed(position) => {
                                if position.x + self.x < 0px {
                                    self.scroll-x = -position.x;
                                } else if position.x + self.x + self.text-cursor-width > parent.width {
                                    self.scroll-x = parent.width - position.x - self.text-cursor-width;
                                }
                            }
                            edited => { root.search-changed(self.text); }
                            accepted => { root.search-submitted(self.text); }
                        }

                        placeholder := Text {
                            width: parent.width;
                            height: parent.height;
                            visible: root.search-text == "" && search-input.preedit-text == "";
                            text: root.indexed-search ? "Search index..." : "Filter folder...";
                            font-size: search-input.font-size;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }

                    // Clear search button
                    if root.search-text != "" : VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: OnyxTheme.radius-sm;
                            background: clear-ta.has-hover ? OnyxTheme.bg-hover : transparent;
                            accessible-role: button;
                            accessible-label: "Clear search";

                            OnyxIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "close";
                                icon-color: OnyxTheme.text-muted;
                            }

                            clear-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.search-text = "";
                                    root.search-changed("");
                                }
                            }
                        }
                    }

                    // Indexed Search toggle chip
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;

                        FluentChip {
                            label: "Index";
                            a11y-label: "Toggle indexed search";
                            active: root.indexed-search;
                            clicked => { root.toggle-indexed-search(); }
                        }
                    }
                }
            }
        }
    }
}
