import { OnyxTheme } from "../tokens.slint";

// Reusable vertical resize splitter with window-relative drag tracking and keyboard support.
export component ResizeSplitter inherits Rectangle {
    in property <string> a11y-label: "Resize pane";
    in property <string> a11y-value: "";
    in property <length> keyboard-step: 16px;
    in property <length> keyboard-large-step: 40px;

    out property <bool> dragging: false;
    out property <bool> has-focus: fs.has-focus;

    callback drag-started();
    // Delta in logical px from drag start, computed in fixed window coordinates.
    callback drag-moved(length);
    callback drag-ended();
    callback drag-cancelled();
    // Signed delta in logical px from Left/Right arrow keys.
    callback step-resize(length);

    property <length> drag-start-abs-x: 0px;

    width: 6px;
    background: transparent;

    accessible-role: slider;
    accessible-label: root.a11y-label;
    accessible-value: root.a11y-value;

    // Visible focus ring when keyboard-focused
    if fs.has-focus : Rectangle {
        x: 0px;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        border-radius: 3px;
        border-width: 1.5px;
        border-color: OnyxTheme.border-focus;
        background: OnyxTheme.accent-subtle;
    }

    // Center hairline / active drag bar
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0px;
        width: (root.dragging || ta.has-hover || fs.has-focus) ? 2px : 1px;
        height: parent.height;
        background: (root.dragging || fs.has-focus)
            ? OnyxTheme.accent-bright
            : (ta.has-hover ? OnyxTheme.accent-effective : OnyxTheme.border-subtle);

        animate background { duration: 100ms; }
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.step-resize(event.modifiers.shift ? -root.keyboard-large-step : -root.keyboard-step);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.step-resize(event.modifiers.shift ? root.keyboard-large-step : root.keyboard-step);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            mouse-cursor: col-resize;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.dragging = true;
                    root.drag-start-abs-x = self.absolute-position.x + self.mouse-x;
                    root.drag-started();
                } else if event.kind == PointerEventKind.up {
                    if root.dragging {
                        root.dragging = false;
                        root.drag-ended();
                    }
                } else if event.kind == PointerEventKind.cancel {
                    if root.dragging {
                        root.dragging = false;
                        root.drag-cancelled();
                    }
                }
            }

            moved => {
                if root.dragging {
                    root.drag-moved((self.absolute-position.x + self.mouse-x) - root.drag-start-abs-x);
                }
            }
        }
    }
}
