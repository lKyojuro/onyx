import { OnyxTheme } from "../tokens.slint";
import { UiTabItem } from "../types.slint";
import { FluentButton } from "common.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

// Windows 11 File Explorer style tab strip:
// Active tab has rounded top corners and merges seamlessly into NavBar below.
export component TabBar inherits Rectangle {
    in property <[UiTabItem]> tabs;
    in property <bool> dual-pane: false;

    callback new-tab();
    callback close-tab(int);
    callback switch-tab(int);
    callback reorder-tab(int, int);
    callback move-tab-to-other-pane(int);

    height: 40px;
    background: OnyxTheme.dark-mode ? OnyxTheme.bg-sidebar : OnyxTheme.bg-base;

    // Bottom hairline separating inactive tab strip from NavBar below
    // (covered cleanly by the active tab's seamless bottom bridge)
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: OnyxTheme.border-subtle;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 0px;
        spacing: 2px;
        alignment: start;

        // Tab strip
        HorizontalLayout {
            spacing: 0px;
            horizontal-stretch: 1;
            accessible-role: tab-list;
            accessible-label: "Open tabs";

            for tab[idx] in root.tabs : Rectangle {
                property <bool> next-is-active: idx + 1 < root.tabs.length && root.tabs[idx + 1].active;
                property <bool> is-hovered: tab-ta.has-hover || close-ta.has-hover;

                min-width: 120px;
                max-width: 236px;
                horizontal-stretch: 1;
                height: 34px;
                background: transparent;

                accessible-role: AccessibleRole.tab;
                accessible-label: tab.title;

                // Tab visual surface:
                // Active tab: rounded top corners (8px), flush with bottom, matches NavBar (bg-chrome)
                // Inactive tab: subtle rounded hover pill inset slightly from bottom
                Rectangle {
                    x: 1px;
                    y: tab.active ? 0px : 2px;
                    width: parent.width - 2px;
                    height: tab.active ? parent.height : (parent.height - 6px);
                    border-top-left-radius: tab.active ? 8px : 6px;
                    border-top-right-radius: tab.active ? 8px : 6px;
                    border-bottom-left-radius: tab.active ? 0px : 6px;
                    border-bottom-right-radius: tab.active ? 0px : 6px;
                    border-width: tab.active ? 1px : 0px;
                    border-color: tab.active ? OnyxTheme.border-subtle : transparent;
                    background: tab.active
                        ? OnyxTheme.bg-chrome
                        : (parent.is-hovered ? OnyxTheme.bg-hover : transparent);

                    animate background { duration: 140ms; easing: ease-out; }
                    animate border-color { duration: 140ms; easing: ease-out; }

                    // Seamless bottom bridge over the 1px strip hairline so active tab merges into NavBar
                    if tab.active : Rectangle {
                        x: 1px;
                        y: parent.height - 2px;
                        width: parent.width - 2px;
                        height: 3px;
                        background: OnyxTheme.bg-chrome;
                    }

                    // Subtle top specular accent on active tab
                    if tab.active : Rectangle {
                        x: 10px;
                        y: 1px;
                        width: parent.width - 20px;
                        height: 1px;
                        background: OnyxTheme.border-specular;
                    }
                }

                // Subtle vertical divider between inactive tabs (hidden next to active or hovered tab)
                if !tab.active && !next-is-active && !is-hovered && idx < root.tabs.length - 1 : Rectangle {
                    x: parent.width - 1px;
                    y: 9px;
                    width: 1px;
                    height: 16px;
                    background: OnyxTheme.border-subtle;
                    opacity: 0.85;
                    animate opacity { duration: 120ms; easing: ease-out; }
                }

                // Context menu on tab (right-click)
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Move to Other Pane";
                            enabled: root.dual-pane;
                            activated => { root.move-tab-to-other-pane(tab.id); }
                        }
                        MenuItem {
                            title: "Close Tab";
                            activated => { root.close-tab(tab.id); }
                        }
                    }

                    // Background click area for tab switching
                    tab-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.switch-tab(tab.id); }
                    }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    padding-bottom: tab.active ? 0px : 2px;
                    spacing: 5px;

                    // Subtle active indicator dot
                    if tab.active : Rectangle {
                        width: 6px;
                        height: 6px;
                        y: 14px;
                        border-radius: 3px;
                        background: OnyxTheme.accent-bright;
                    }

                    Text {
                        text: tab.title != "" ? tab.title : "New Tab";
                        font-size: OnyxTheme.font-sm;
                        font-weight: tab.active ? 600 : 400;
                        color: tab.active ? OnyxTheme.text-primary : OnyxTheme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Move tab left button
                    if root.tabs.length > 1 && idx > 0 : Rectangle {
                        width: (tab.active || is-hovered || left-ta.has-hover) ? 18px : 0px;
                        height: 18px;
                        y: 8px;
                        clip: true;
                        border-radius: OnyxTheme.radius-sm;
                        background: left-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Move tab left";

                        OnyxIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "chevron-left";
                            size: OnyxIconSize.small;
                            icon-color: OnyxTheme.text-muted;
                        }

                        left-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.reorder-tab(idx, idx - 1); }
                        }
                    }

                    // Move tab right button
                    if root.tabs.length > 1 && idx < root.tabs.length - 1 : Rectangle {
                        width: (tab.active || is-hovered || right-ta.has-hover) ? 18px : 0px;
                        height: 18px;
                        y: 8px;
                        clip: true;
                        border-radius: OnyxTheme.radius-sm;
                        background: right-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Move tab right";

                        OnyxIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "chevron-right";
                            size: OnyxIconSize.small;
                            icon-color: OnyxTheme.text-muted;
                        }

                        right-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.reorder-tab(idx, idx + 1); }
                        }
                    }

                    // Move tab to other pane button (visible when dual-pane is active)
                    if root.dual-pane : Rectangle {
                        width: (tab.active || is-hovered || move-pane-ta.has-hover) ? 18px : 0px;
                        height: 18px;
                        y: 8px;
                        clip: true;
                        border-radius: OnyxTheme.radius-sm;
                        background: move-pane-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Move tab to other pane";

                        OnyxIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "arrow-left-right";
                            size: OnyxIconSize.small;
                            icon-color: move-pane-ta.has-hover ? OnyxTheme.accent-bright : OnyxTheme.text-muted;
                        }

                        move-pane-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.move-tab-to-other-pane(tab.id); }
                        }
                    }

                    // Close tab button
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: 7px;
                        border-radius: OnyxTheme.radius-sm;
                        background: close-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
                        opacity: (tab.active || is-hovered) ? 1.0 : 0.55;
                        animate background { duration: 120ms; easing: ease-out; }
                        animate opacity { duration: 120ms; easing: ease-out; }
                        accessible-role: button;
                        accessible-label: "Close tab";

                        OnyxIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "close";
                            size: OnyxIconSize.small;
                            icon-color: close-ta.has-hover ? OnyxTheme.text-primary : OnyxTheme.text-muted;
                        }

                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-tab(tab.id); }
                        }
                    }
                }
            }

            // New tab '+' button sitting cleanly right next to the last tab
            VerticalLayout {
                alignment: center;
                padding-left: 4px;
                padding-bottom: 2px;

                FluentButton {
                    icon-name: "plus";
                    a11y-label: "New tab";
                    compact: true;
                    min-btn-width: 28px;
                    clicked => { root.new-tab(); }
                }
            }

            // Right spacer to keep tabs + '+' button anchored cleanly left
            Rectangle {
                horizontal-stretch: 0.25;
            }
        }
    }
}
