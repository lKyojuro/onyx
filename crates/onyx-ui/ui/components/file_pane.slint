import { ListView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiFileEntry } from "../types.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

component EntryGlyph inherits Rectangle {
    in property <bool> is-dir: false;
    in property <bool> is-symlink: false;
    in property <bool> has-icon: false;
    in property <image> icon;
    in property <length> icon-size: 18px;

    width: icon-size;
    height: icon-size;

    if root.has-icon : Image {
        width: parent.width;
        height: parent.height;
        source: root.icon;
        image-fit: contain;
    }

    if !root.has-icon : OnyxIcon {
        name: root.is-dir ? "folder" : "file";
        size: root.icon-size;
        icon-color: root.is-dir ? OnyxTheme.folder-tint : OnyxTheme.file-tint;
    }

    if root.is-symlink : Rectangle {
        x: parent.width - 9px;
        y: parent.height - 9px;
        width: 9px;
        height: 9px;
        border-radius: 2px;
        background: OnyxTheme.bg-surface;
        border-width: 1px;
        border-color: OnyxTheme.symlink-tint;

        OnyxIcon {
            size: 8px;
            name: "arrow-up-right";
            icon-color: OnyxTheme.symlink-tint;
        }
    }
}

component ColumnHeaderButton inherits Rectangle {
    in property <string> label;
    in property <int> column-index;
    in property <int> active-column;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> text-align: left;

    callback clicked();

    height: 28px;
    border-radius: OnyxTheme.radius-sm;
    background: ta.has-hover ? OnyxTheme.bg-hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: "Sort by " + root.label;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: root.text-align == right ? end : start;

        Text {
            text: root.label;
            font-size: OnyxTheme.font-xs;
            font-weight: root.active-column == root.column-index ? 600 : 500;
            color: root.active-column == root.column-index ? OnyxTheme.accent-bright : OnyxTheme.text-muted;
            vertical-alignment: center;
            horizontal-alignment: root.text-align;
            overflow: elide;
        }

        if root.active-column == root.column-index : VerticalLayout {
            alignment: center;
            OnyxIcon {
                name: root.ascending ? "sort-ascending" : "sort-descending";
                size: OnyxIconSize.small;
                icon-color: OnyxTheme.accent-bright;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component FilePane inherits Rectangle {
    in property <int> pane-index: 0;
    in property <bool> is-active: true;
    in property <bool> show-active-indicator: false;
    in property <bool> dual-pane: false;
    in property <string> current-path: "";
    in property <[UiFileEntry]> entries;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    in property <int> view-mode: 0; // 0 = Details, 1 = Grid
    in property <bool> is-loading: false;
    in property <bool> has-search-query: false;
    in property <string> error-message: "";

    // Shared internal drag-and-drop state
    in-out property <bool> dragging-active: false;
    in property <int> drag-generation: 0;
    in-out property <string> drag-source-path: "";
    in-out property <string> drag-source-name: "";
    in-out property <string> drag-source-dir: "";
    in-out property <bool> drag-source-is-dir: false;
    in-out property <image> drag-source-icon;
    in-out property <bool> drag-source-has-icon: false;
    in-out property <int> drag-source-pane: -1;
    in-out property <length> drag-x: 0px;
    in-out property <length> drag-y: 0px;
    in-out property <string> drag-hover-folder-path: "";
    in-out property <int> drag-hover-pane: -1;
    in-out property <string> drag-hover-pane-path: "";

    callback select-entry(int, int);
    callback activate-entry(int, int);
    callback context-menu-requested(int, int);
    callback set-active-pane(int);
    callback sort-by(int, int);
    callback finish-internal-drag(bool);
    callback cancel-internal-drag();

    out property <int> grid-columns: Math.max(1, Math.floor((self.width - 24px) / 140px));
    property <int> grid-rows: root.entries.length == 0
        ? 0
        : Math.floor((root.entries.length + root.grid-columns - 1) / root.grid-columns);
    // Keep room for file names when two panes and the preview share the window.
    property <bool> show-type-column: self.width >= 520px;
    property <bool> show-date-column: self.width >= 370px;
    property <length> size-column-width: self.width >= 520px ? 88px : 72px;

    property <bool> is-pane-drop-hovered: root.dragging-active
        && root.dual-pane
        && root.drag-source-pane != root.pane-index
        && root.current-path != ""
        && root.current-path != root.drag-source-dir
        && root.drag-x >= self.absolute-position.x
        && root.drag-x <= self.absolute-position.x + self.width
        && root.drag-y >= self.absolute-position.y
        && root.drag-y < self.absolute-position.y + self.height;
    property <bool> show-pane-drop-target: root.is-pane-drop-hovered && root.drag-hover-folder-path == "";

    changed is-pane-drop-hovered => {
        if self.is-pane-drop-hovered {
            root.drag-hover-pane = root.pane-index;
            root.drag-hover-pane-path = root.current-path;
        } else if root.drag-hover-pane == root.pane-index {
            root.drag-hover-pane = -1;
            root.drag-hover-pane-path = "";
        }
    }

    background: OnyxTheme.bg-surface;
    clip: true;

    // Clicking empty pane space activates this pane
    TouchArea {
        clicked => { root.set-active-pane(root.pane-index); }
    }

    VerticalLayout {
        spacing: 0px;

        // Subtle active-pane top accent bar when dual-pane is enabled
        if root.show-active-indicator : Rectangle {
            height: 2px;
            background: root.is-active ? OnyxTheme.accent-bright : OnyxTheme.border-subtle;
            animate background { duration: 130ms; }
        }

        // Compact pane path header in dual-pane mode
        if root.show-active-indicator : Rectangle {
            height: 26px;
            background: root.show-pane-drop-target ? OnyxTheme.bg-selected : OnyxTheme.bg-chrome;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.show-pane-drop-target ? OnyxTheme.accent-bright : OnyxTheme.border-subtle;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.set-active-pane(root.pane-index); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: 10px;
                    border-radius: 3px;
                    background: root.is-active ? OnyxTheme.accent-bright : OnyxTheme.text-muted;
                }

                Text {
                    text: root.current-path != "" ? root.current-path : (root.pane-index == 0 ? "Primary Pane" : "Secondary Pane");
                    font-size: OnyxTheme.font-xs;
                    font-weight: root.is-active ? 600 : 400;
                    color: root.is-active ? OnyxTheme.text-primary : OnyxTheme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // Top non-blocking loading indicator bar when refreshing populated folder
        if root.is-loading && root.entries.length > 0 : Rectangle {
            height: 2px;
            background: OnyxTheme.accent-bright;
            opacity: 0.85;
        }

        // Details View Column Header Row
        if root.view-mode == 0 && root.error-message == "" : Rectangle {
            height: 30px;
            background: OnyxTheme.dark-mode ? #080817b8 : OnyxTheme.bg-surface-alt;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: OnyxTheme.border-subtle;
            }

            HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 10px;
                padding-right: 18px;
                spacing: 4px;
                alignment: stretch;

                ColumnHeaderButton {
                    label: "Name";
                    column-index: 0;
                    active-column: root.sort-column;
                    ascending: root.sort-ascending;
                    horizontal-stretch: 1;
                    clicked => {
                        root.set-active-pane(root.pane-index);
                        root.sort-by(root.pane-index, 0);
                    }
                }

                if root.show-date-column : ColumnHeaderButton {
                    label: "Date modified";
                    column-index: 1;
                    active-column: root.sort-column;
                    ascending: root.sort-ascending;
                    width: 144px;
                    horizontal-stretch: 0;
                    clicked => {
                        root.set-active-pane(root.pane-index);
                        root.sort-by(root.pane-index, 1);
                    }
                }

                if root.show-type-column : ColumnHeaderButton {
                    label: "Type";
                    column-index: 2;
                    active-column: root.sort-column;
                    ascending: root.sort-ascending;
                    width: 120px;
                    horizontal-stretch: 0;
                    clicked => {
                        root.set-active-pane(root.pane-index);
                        root.sort-by(root.pane-index, 2);
                    }
                }

                ColumnHeaderButton {
                    label: "Size";
                    column-index: 3;
                    active-column: root.sort-column;
                    ascending: root.sort-ascending;
                    text-align: right;
                    width: root.size-column-width;
                    horizontal-stretch: 0;
                    clicked => {
                        root.set-active-pane(root.pane-index);
                        root.sort-by(root.pane-index, 3);
                    }
                }
            }
        }

        // Error State
        if root.error-message != "" : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 24px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        max-width: 440px;
                        border-radius: OnyxTheme.radius-lg;
                        border-width: 1px;
                        border-color: OnyxTheme.danger;
                        background: OnyxTheme.danger-bg;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;

                            Text {
                                text: "Unable to open location";
                                font-size: OnyxTheme.font-md;
                                font-weight: 600;
                                color: OnyxTheme.danger;
                            }

                            Text {
                                text: root.error-message;
                                font-size: OnyxTheme.font-sm;
                                color: OnyxTheme.text-primary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // Centered Loading State (when folder has no entries yet)
        if root.error-message == "" && root.is-loading && root.entries.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    OnyxIcon {
                        name: "refresh";
                        size: 26px;
                        icon-color: OnyxTheme.accent-bright;
                    }
                }

                Text {
                    text: "Loading folder...";
                    font-size: OnyxTheme.font-md;
                    color: OnyxTheme.text-secondary;
                    horizontal-alignment: center;
                }
            }
        }

        // Empty Folder State
        if root.error-message == "" && !root.is-loading && root.entries.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: transparent;

            VerticalLayout {
                alignment: center;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    OnyxIcon {
                        name: root.has-search-query ? "search" : "folder";
                        size: 36px;
                        icon-color: OnyxTheme.text-muted;
                    }
                }

                Text {
                    text: root.has-search-query ? "No matching items" : "This folder is empty";
                    font-size: OnyxTheme.font-md;
                    font-weight: 500;
                    color: OnyxTheme.text-secondary;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.has-search-query
                        ? "Try a different search term or clear the search box."
                        : "Create a new folder or navigate using the sidebar.";
                    font-size: OnyxTheme.font-xs;
                    color: OnyxTheme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        // Virtualized Details ListView
        if root.error-message == "" && root.entries.length > 0 && root.view-mode == 0 : ListView {
            vertical-stretch: 1;
            changed viewport-y => {
                if root.dragging-active { root.cancel-internal-drag(); }
            }
            accessible-role: list;
            accessible-label: "Directory contents";

            for entry[idx] in root.entries : Rectangle {
                height: 33px;
                background: transparent;

                Rectangle {
                    property <bool> is-drop-target: root.dragging-active
                        && entry.is_dir
                        && entry.path != root.drag-source-path
                        && root.drag-x >= self.absolute-position.x
                        && root.drag-x <= self.absolute-position.x + self.width
                        && root.drag-y >= self.absolute-position.y
                        && root.drag-y < self.absolute-position.y + self.height;

                    changed is-drop-target => {
                        if self.is-drop-target {
                            root.drag-hover-folder-path = entry.path;
                        } else if root.drag-hover-folder-path == entry.path {
                            root.drag-hover-folder-path = "";
                        }
                    }

                    x: 6px;
                    y: 1px;
                    width: parent.width - 12px;
                    height: parent.height - 2px;
                    border-radius: OnyxTheme.radius-sm;
                    border-width: self.is-drop-target ? 1.5px : (entry.selected ? 1px : 0px);
                    border-color: self.is-drop-target
                        ? OnyxTheme.accent-bright
                        : (entry.selected ? OnyxTheme.accent-border : transparent);
                    background: self.is-drop-target
                        ? OnyxTheme.accent-subtle
                        : (entry.selected
                            ? OnyxTheme.bg-selected
                            : (row-ta.has-hover ? OnyxTheme.bg-hover : transparent));

                    animate background { duration: 80ms; }

                    accessible-role: list-item;
                    accessible-label: entry.name;

                    // Luminous violet left pip on selected row
                    if entry.selected : Rectangle {
                        x: 2px;
                        y: 7px;
                        width: 3px;
                        height: 17px;
                        border-radius: 1.5px;
                        background: OnyxTheme.accent-bright;
                    }

                    row-ta := TouchArea {
                        property <int> armed-generation: -1;
                        property <length> press-x: 0px;
                        property <length> press-y: 0px;

                        mouse-cursor: root.dragging-active ? grabbing : pointer;
                        clicked => {
                            root.set-active-pane(root.pane-index);
                            root.select-entry(root.pane-index, idx);
                        }
                        double-clicked => {
                            root.set-active-pane(root.pane-index);
                            root.activate-entry(root.pane-index, idx);
                        }
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                if root.dragging-active {
                                    root.cancel-internal-drag();
                                } else {
                                    root.context-menu-requested(root.pane-index, idx);
                                }
                            }
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                if root.dragging-active {
                                    root.cancel-internal-drag();
                                }
                                self.armed-generation = root.drag-generation;
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                            }
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                if self.armed-generation == root.drag-generation && root.dragging-active
                                    && root.drag-source-path == entry.path {
                                    root.finish-internal-drag(event.modifiers.control);
                                }
                                self.armed-generation = -1;
                            }
                            if event.kind == PointerEventKind.cancel {
                                if root.dragging-active {
                                    root.cancel-internal-drag();
                                }
                                self.armed-generation = -1;
                            }
                        }
                        moved => {
                            if self.armed-generation == root.drag-generation {
                                if !root.dragging-active && (Math.abs(self.mouse-x - self.press-x) + Math.abs(self.mouse-y - self.press-y) > 8px) {
                                    root.select-entry(root.pane-index, idx);
                                    root.dragging-active = true;
                                    root.drag-source-path = entry.path;
                                    root.drag-source-name = entry.name;
                                    root.drag-source-dir = root.current-path;
                                    root.drag-source-is-dir = entry.is_dir;
                                    root.drag-source-icon = entry.icon;
                                    root.drag-source-has-icon = entry.has_icon;
                                    root.drag-source-pane = root.pane-index;
                                }
                                if root.dragging-active {
                                    root.drag-x = self.absolute-position.x + self.mouse-x;
                                    root.drag-y = self.absolute-position.y + self.mouse-y;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 4px;
                        opacity: entry.is_hidden ? 0.62 : 1.0;

                        // Name + Icon
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 9px;

                            EntryGlyph {
                                y: 6px;
                                is-dir: entry.is_dir;
                                is-symlink: entry.is_symlink;
                                has-icon: entry.has_icon;
                                icon: entry.icon;
                                icon-size: 18px;
                            }

                            Text {
                                text: entry.name;
                                font-size: OnyxTheme.font-sm;
                                font-weight: entry.selected ? 600 : (entry.is_dir ? 500 : 400);
                                color: OnyxTheme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }

                        // Date modified
                        if root.show-date-column : Text {
                            text: entry.modified;
                            font-size: OnyxTheme.font-xs;
                            color: OnyxTheme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                            width: 144px;
                            horizontal-stretch: 0;
                        }

                        // Type
                        if root.show-type-column : Text {
                            text: entry.type_label;
                            font-size: OnyxTheme.font-xs;
                            color: OnyxTheme.text-secondary;
                            vertical-alignment: center;
                            overflow: elide;
                            width: 120px;
                            horizontal-stretch: 0;
                        }

                        // Size
                        Text {
                            text: entry.size_label;
                            font-size: OnyxTheme.font-xs;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                            width: root.size-column-width;
                            horizontal-stretch: 0;
                        }
                    }
                }
            }
        }

        // Virtualized Row-Chunked Grid ListView
        if root.error-message == "" && root.entries.length > 0 && root.view-mode == 1 : ListView {
            vertical-stretch: 1;
            changed viewport-y => {
                if root.dragging-active { root.cancel-internal-drag(); }
            }
            accessible-role: list;
            accessible-label: "Directory grid";

            for row-idx in root.grid-rows : Rectangle {
                height: 134px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    for col-idx in root.grid-columns : Rectangle {
                        property <int> item-idx: row-idx * root.grid-columns + col-idx;
                        property <bool> valid: item-idx < root.entries.length;
                        property <UiFileEntry> entry: root.entries[item-idx];
                        property <bool> is-drop-target: valid
                            && root.dragging-active
                            && entry.is_dir
                            && entry.path != root.drag-source-path
                            && root.drag-x >= self.absolute-position.x
                            && root.drag-x <= self.absolute-position.x + self.width
                            && root.drag-y >= self.absolute-position.y
                            && root.drag-y < self.absolute-position.y + self.height;

                        changed is-drop-target => {
                            if self.is-drop-target {
                                root.drag-hover-folder-path = entry.path;
                            } else if root.drag-hover-folder-path == entry.path {
                                root.drag-hover-folder-path = "";
                            }
                        }

                        horizontal-stretch: 1;
                        height: 122px;
                        border-radius: OnyxTheme.radius-md;
                        border-width: self.is-drop-target ? 2px : 1px;
                        border-color: !valid
                            ? transparent
                            : (self.is-drop-target
                                ? OnyxTheme.accent-bright
                                : (entry.selected
                                    ? OnyxTheme.accent-border
                                    : (tile-ta.has-hover ? OnyxTheme.border-strong : OnyxTheme.border-subtle)));
                        background: !valid
                            ? transparent
                            : (self.is-drop-target
                                ? OnyxTheme.accent-subtle
                                : (entry.selected
                                    ? OnyxTheme.bg-selected
                                    : (tile-ta.has-hover ? OnyxTheme.bg-hover : OnyxTheme.bg-surface-alt)));

                        animate background { duration: 90ms; }

                        tile-ta := TouchArea {
                            property <int> armed-generation: -1;
                            property <length> press-x: 0px;
                            property <length> press-y: 0px;

                            enabled: valid;
                            mouse-cursor: valid ? (root.dragging-active ? grabbing : pointer) : default;
                            clicked => {
                                root.set-active-pane(root.pane-index);
                                root.select-entry(root.pane-index, item-idx);
                            }
                            double-clicked => {
                                root.set-active-pane(root.pane-index);
                                root.activate-entry(root.pane-index, item-idx);
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                    if root.dragging-active {
                                        root.cancel-internal-drag();
                                    } else {
                                        root.context-menu-requested(root.pane-index, item-idx);
                                    }
                                }
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    if root.dragging-active {
                                        root.cancel-internal-drag();
                                    }
                                    self.armed-generation = root.drag-generation;
                                    self.press-x = self.mouse-x;
                                    self.press-y = self.mouse-y;
                                }
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                                    if self.armed-generation == root.drag-generation && root.dragging-active
                                        && root.drag-source-path == entry.path {
                                        root.finish-internal-drag(event.modifiers.control);
                                    }
                                    self.armed-generation = -1;
                                }
                                if event.kind == PointerEventKind.cancel {
                                    if root.dragging-active {
                                        root.cancel-internal-drag();
                                    }
                                    self.armed-generation = -1;
                                }
                            }
                            moved => {
                                if self.armed-generation == root.drag-generation {
                                    if !root.dragging-active && (Math.abs(self.mouse-x - self.press-x) + Math.abs(self.mouse-y - self.press-y) > 8px) {
                                        root.select-entry(root.pane-index, item-idx);
                                        root.dragging-active = true;
                                        root.drag-source-path = entry.path;
                                        root.drag-source-name = entry.name;
                                        root.drag-source-dir = root.current-path;
                                        root.drag-source-is-dir = entry.is_dir;
                                        root.drag-source-icon = entry.has_thumbnail ? entry.thumbnail : entry.icon;
                                        root.drag-source-has-icon = entry.has_thumbnail || entry.has_icon;
                                        root.drag-source-pane = root.pane-index;
                                    }
                                    if root.dragging-active {
                                        root.drag-x = self.absolute-position.x + self.mouse-x;
                                        root.drag-y = self.absolute-position.y + self.mouse-y;
                                    }
                                }
                            }
                        }

                        if valid : VerticalLayout {
                            accessible-role: list-item;
                            accessible-label: entry.name;
                            padding: 8px;
                            spacing: 6px;
                            alignment: center;
                            opacity: entry.is_hidden ? 0.62 : 1.0;

                            HorizontalLayout {
                                alignment: center;

                                if entry.has_thumbnail : Rectangle {
                                    width: 96px;
                                    height: 58px;
                                    border-radius: OnyxTheme.radius-sm;
                                    background: OnyxTheme.bg-chrome;
                                    border-width: 1px;
                                    border-color: OnyxTheme.border-subtle;
                                    clip: true;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: entry.thumbnail;
                                        image-fit: contain;
                                    }
                                }

                                if !entry.has_thumbnail : VerticalLayout {
                                    height: 58px;
                                    alignment: center;

                                    EntryGlyph {
                                        is-dir: entry.is_dir;
                                        is-symlink: entry.is_symlink;
                                        has-icon: entry.has_icon;
                                        icon: entry.icon;
                                        icon-size: 40px;
                                    }
                                }
                            }

                            Text {
                                text: entry.name;
                                font-size: OnyxTheme.font-xs;
                                font-weight: entry.selected ? 600 : 400;
                                color: OnyxTheme.text-primary;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: entry.size_label != "" ? entry.size_label : entry.type_label;
                                font-size: OnyxTheme.font-xs;
                                color: OnyxTheme.text-muted;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
