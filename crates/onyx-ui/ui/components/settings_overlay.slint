import { LineEdit, ScrollView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { FluentButton, FluentChip, HorizontalDivider } from "common.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

component FluentSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <string> a11y-label: "";

    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.checked ? OnyxTheme.accent-effective : OnyxTheme.border-strong;
    background: root.checked
        ? (ta.has-hover ? OnyxTheme.accent-effective.brighter(8%) : OnyxTheme.accent-effective)
        : (ta.has-hover ? OnyxTheme.bg-hover : OnyxTheme.bg-input);

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    accessible-role: checkbox;
    accessible-label: root.a11y-label;
    accessible-checked: root.checked;

    Rectangle {
        x: root.checked ? 21px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? OnyxTheme.text-on-accent : OnyxTheme.text-secondary;

        animate x { duration: 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> description: "";

    min-height: 44px;
    border-radius: OnyxTheme.radius-md;
    background: OnyxTheme.bg-surface-alt;
    border-width: 1px;
    border-color: OnyxTheme.border-subtle;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.title;
                font-size: OnyxTheme.font-sm;
                font-weight: 500;
                color: OnyxTheme.text-primary;
                overflow: elide;
            }

            if root.description != "" : Text {
                text: root.description;
                font-size: OnyxTheme.font-xs;
                color: OnyxTheme.text-muted;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: center;
            spacing: 6px;

            @children
        }
    }
}

component SettingsSectionHeader inherits Text {
    font-size: OnyxTheme.font-xs;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: OnyxTheme.accent-bright;
}

export component SettingsOverlayModal inherits Rectangle {
    in property <int> theme-mode: 0; // 0 = Dark, 1 = Light, 2 = System
    in property <int> default-view: 0; // 0 = Details, 1 = Grid
    in property <bool> show-hidden: false;
    in property <bool> show-system: false;
    in property <bool> show-preview-pane: true;
    in property <bool> dual-pane-default: false;
    in property <string> default-terminal: "wt";
    in property <[string]> excluded-dirs;

    in-out property <string> new-excluded-dir: "";

    callback set-theme(int);
    callback set-default-view(int);
    callback set-show-hidden(bool);
    callback set-show-system(bool);
    callback set-show-preview(bool);
    callback set-dual-pane-default(bool);
    callback set-default-terminal(string);
    callback add-excluded-dir(string);
    callback remove-excluded-dir(string);
    callback close();

    public function focus-panel() {
        settings-scope.focus();
    }

    background: OnyxTheme.bg-backdrop;

    // Click backdrop to dismiss
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(640px, parent.width - 48px);
        height: Math.min(620px, parent.height - 64px);
        border-radius: OnyxTheme.radius-lg;
        border-width: 1px;
        border-color: OnyxTheme.border-strong;
        background: OnyxTheme.bg-elevated;
        clip: true;

        // Subtle specular top highlight
        Rectangle {
            x: 12px;
            y: 1px;
            width: parent.width - 24px;
            height: 1px;
            background: OnyxTheme.border-specular;
        }

        // Absorb clicks inside modal
        TouchArea { }

        settings-scope := FocusScope {
            width: parent.width;
            height: parent.height;

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            OnyxIcon {
                                name: "settings";
                                size: 18px;
                                icon-color: OnyxTheme.accent-bright;
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;
                            alignment: center;

                            Text {
                                text: "Settings";
                                font-size: OnyxTheme.font-lg;
                                font-weight: 600;
                                color: OnyxTheme.text-primary;
                            }

                            Text {
                                text: "Appearance, browsing behavior, terminal, and search indexing";
                                font-size: OnyxTheme.font-xs;
                                color: OnyxTheme.text-muted;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        FluentChip {
                            y: 3px;
                            label: "Esc";
                            interactive: true;
                            a11y-label: "Close settings";
                            clicked => { root.close(); }
                        }

                        FluentButton {
                            icon-name: "close";
                            a11y-label: "Close settings";
                            compact: true;
                            clicked => { root.close(); }
                        }
                    }
                }

                HorizontalDivider { }

                // Scrollable Settings Body
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        // --- Appearance ---
                        SettingsSectionHeader {
                            text: "APPEARANCE";
                        }

                        SettingsRow {
                            title: "Theme";
                            description: "Choose Dark, Light, or follow the Windows theme.";

                            FluentButton {
                                label: "Dark";
                                compact: true;
                                active: root.theme-mode == 0;
                                clicked => { root.set-theme(0); }
                            }

                            FluentButton {
                                label: "Light";
                                compact: true;
                                active: root.theme-mode == 1;
                                clicked => { root.set-theme(1); }
                            }

                            FluentButton {
                                label: "System";
                                compact: true;
                                active: root.theme-mode == 2;
                                clicked => { root.set-theme(2); }
                            }
                        }

                        // --- Browsing & Layout ---
                        Rectangle { height: 4px; }

                        SettingsSectionHeader {
                            text: "BROWSING & LAYOUT";
                        }

                        SettingsRow {
                            title: "Default View";
                            description: "Layout used for directory panes (Grid loads async image thumbnails).";

                            FluentButton {
                                icon-name: "list";
                                label: "Details";
                                compact: true;
                                active: root.default-view == 0;
                                clicked => { root.set-default-view(0); }
                            }

                            FluentButton {
                                icon-name: "grid";
                                label: "Grid";
                                compact: true;
                                active: root.default-view == 1;
                                clicked => { root.set-default-view(1); }
                            }
                        }

                        SettingsRow {
                            title: "Show Hidden Files";
                            description: "Display hidden files and dotfiles in directory listings and search.";

                            FluentSwitch {
                                checked: root.show-hidden;
                                a11y-label: "Show hidden files";
                                toggled(val) => { root.set-show-hidden(val); }
                            }
                        }

                        SettingsRow {
                            title: "Show System Files";
                            description: "Display protected Windows operating system files.";

                            FluentSwitch {
                                checked: root.show-system;
                                a11y-label: "Show system files";
                                toggled(val) => { root.set-show-system(val); }
                            }
                        }

                        SettingsRow {
                            title: "Show Preview Pane";
                            description: "Dock the live file preview inspector on the right side.";

                            FluentSwitch {
                                checked: root.show-preview-pane;
                                a11y-label: "Show preview pane";
                                toggled(val) => { root.set-show-preview(val); }
                            }
                        }

                        SettingsRow {
                            title: "Dual-Pane Default";
                            description: "Open side-by-side dual panes for fast drag-and-drop and comparison.";

                            FluentSwitch {
                                checked: root.dual-pane-default;
                                a11y-label: "Dual-pane default";
                                toggled(val) => { root.set-dual-pane-default(val); }
                            }
                        }

                        // --- Terminal ---
                        Rectangle { height: 4px; }

                        SettingsSectionHeader {
                            text: "TERMINAL";
                        }

                        SettingsRow {
                            title: "Default Terminal";
                            description: "Shell launched by Open Terminal (Ctrl+` / Alt+T).";

                            FluentButton {
                                label: "Windows Terminal";
                                compact: true;
                                active: root.default-terminal == "wt";
                                clicked => { root.set-default-terminal("wt"); }
                            }

                            FluentButton {
                                label: "PowerShell";
                                compact: true;
                                active: root.default-terminal == "pwsh";
                                clicked => { root.set-default-terminal("pwsh"); }
                            }

                            FluentButton {
                                label: "Command Prompt";
                                compact: true;
                                active: root.default-terminal == "cmd";
                                clicked => { root.set-default-terminal("cmd"); }
                            }
                        }

                        // --- Search Indexing ---
                        Rectangle { height: 4px; }

                        SettingsSectionHeader {
                            text: "EXCLUDED SEARCH INDEX DIRECTORIES";
                        }

                        Rectangle {
                            border-radius: OnyxTheme.radius-md;
                            background: OnyxTheme.bg-surface-alt;
                            border-width: 1px;
                            border-color: OnyxTheme.border-subtle;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;

                                Text {
                                    text: "Directories or folder names skipped by background search indexing (e.g. C:\\Windows or node_modules).";
                                    font-size: OnyxTheme.font-xs;
                                    color: OnyxTheme.text-muted;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    excluded-input := LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> root.new-excluded-dir;
                                        placeholder-text: "Enter directory path or folder name...";
                                        font-size: OnyxTheme.font-sm;
                                        accepted(val) => {
                                            if val != "" {
                                                root.add-excluded-dir(val);
                                                root.new-excluded-dir = "";
                                            }
                                        }
                                    }

                                    FluentButton {
                                        icon-name: "plus";
                                        label: "Add";
                                        primary: true;
                                        enabled: root.new-excluded-dir != "";
                                        clicked => {
                                            root.add-excluded-dir(root.new-excluded-dir);
                                            root.new-excluded-dir = "";
                                        }
                                    }
                                }

                                if root.excluded-dirs.length == 0 : Text {
                                    text: "No excluded directories configured.";
                                    font-size: OnyxTheme.font-xs;
                                    color: OnyxTheme.text-muted;
                                }

                                for dir in root.excluded-dirs : Rectangle {
                                    height: 32px;
                                    border-radius: OnyxTheme.radius-sm;
                                    background: OnyxTheme.bg-surface;
                                    border-width: 1px;
                                    border-color: OnyxTheme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            alignment: center;
                                            OnyxIcon {
                                                name: "folder";
                                                size: OnyxIconSize.small;
                                                icon-color: OnyxTheme.folder-tint;
                                            }
                                        }

                                        Text {
                                            text: dir;
                                            font-family: OnyxTheme.font-mono;
                                            font-size: OnyxTheme.font-xs;
                                            color: OnyxTheme.text-primary;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        FluentButton {
                                            icon-name: "close";
                                            a11y-label: "Remove excluded directory " + dir;
                                            compact: true;
                                            danger: true;
                                            clicked => { root.remove-excluded-dir(dir); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalDivider { }

                // Footer
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    alignment: space-between;

                    Text {
                        text: "Changes apply immediately and are saved automatically.";
                        font-size: OnyxTheme.font-xs;
                        color: OnyxTheme.text-muted;
                        vertical-alignment: center;
                    }

                    FluentButton {
                        label: "Done";
                        primary: true;
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
}
