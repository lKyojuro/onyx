import { ScrollView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiSidebarItem, UiDriveItem } from "../types.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

component SidebarSectionHeader inherits Rectangle {
    in property <string> label;
    in property <bool> collapsed: false;

    callback toggle();
    callback focus-changed(bool);

    height: 24px;
    border-radius: OnyxTheme.radius-sm;
    border-width: fs.has-focus ? 1.5px : 0px;
    border-color: fs.has-focus ? OnyxTheme.border-focus : transparent;
    background: ta.has-hover ? OnyxTheme.bg-hover : transparent;

    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.label + (root.collapsed ? ", collapsed" : ", expanded");
    accessible-expandable: true;
    accessible-expanded: !root.collapsed;

    fs := FocusScope {
        width: parent.width;
        height: parent.height;

        changed has-focus => {
            root.focus-changed(self.has-focus);
        }

        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            if event.text == Key.LeftArrow && !root.collapsed {
                root.toggle();
                return accept;
            }
            if event.text == Key.RightArrow && root.collapsed {
                root.toggle();
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle(); }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            width: 12px;

            OnyxIcon {
                name: root.collapsed ? "chevron-right" : "chevron-down";
                size: OnyxIconSize.small;
                icon-color: ta.has-hover || fs.has-focus ? OnyxTheme.text-primary : OnyxTheme.text-muted;
            }
        }

        Text {
            text: root.label;
            font-size: OnyxTheme.font-xs;
            font-weight: 700;
            letter-spacing: 0.6px;
            color: ta.has-hover || fs.has-focus ? OnyxTheme.text-primary : OnyxTheme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component SidebarNavRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-glyph: "folder";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> active: false;
    in property <bool> removable: false;

    callback clicked();
    callback remove-clicked();
    callback focus-changed(bool);

    height: 32px;
    border-radius: OnyxTheme.radius-sm;
    border-width: row-fs.has-focus ? 1.5px : (root.active ? 1px : 0px);
    border-color: row-fs.has-focus
        ? OnyxTheme.border-focus
        : (root.active ? OnyxTheme.accent-border : transparent);
    background: root.active
        ? OnyxTheme.bg-selected
        : (row-ta.has-hover ? OnyxTheme.bg-hover : transparent);

    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.label;

    // Luminous violet active left indicator bar
    if root.active : Rectangle {
        x: 2px;
        y: 8px;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: OnyxTheme.accent-bright;
    }

    row-fs := FocusScope {
        width: parent.width;
        height: parent.height;

        changed has-focus => {
            root.focus-changed(self.has-focus);
        }

        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }

        row-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 9px;

        VerticalLayout {
            alignment: center;
            width: 20px;

            if root.has-icon : Image {
                width: 20px;
                height: 20px;
                source: root.icon;
                image-fit: contain;
            }

            if !root.has-icon : OnyxIcon {
                name: root.icon-glyph != "" ? root.icon-glyph : "folder";
                size: 18px;
                icon-color: root.active ? OnyxTheme.accent-bright : OnyxTheme.text-secondary;
            }
        }

        Text {
            text: root.label;
            font-size: OnyxTheme.font-sm;
            font-weight: root.active ? 600 : 400;
            color: root.active ? OnyxTheme.text-primary : OnyxTheme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.removable : Rectangle {
            width: 20px;
            height: 20px;
            y: 5px;
            opacity: (row-ta.has-hover || unpin-ta.has-hover) ? 1.0 : 0.35;
            border-radius: OnyxTheme.radius-sm;
            background: unpin-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
            accessible-role: button;
            accessible-label: "Unpin " + root.label;

            OnyxIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "close";
                icon-color: OnyxTheme.text-muted;
            }

            unpin-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove-clicked(); }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <int> active-pane: 0;
    in property <string> current-path: "";
    in property <string> home-path: "";
    in property <image> home-icon;
    in property <bool> has-home-icon: false;
    in property <[UiSidebarItem]> favorites;
    in property <[UiSidebarItem]> known-folders;
    in property <[UiDriveItem]> drives;
    in property <bool> favorites-collapsed: false;
    in property <bool> quick-access-collapsed: false;
    in property <bool> drives-collapsed: false;

    callback navigate-to(int, string);
    callback unpin-favorite(string);
    callback toggle-group(string);
    callback sidebar-focus-changed(bool);

    property <int> focused-child-count: 0;

    function handle-child-focus(focused: bool) {
        if focused {
            root.focused-child-count += 1;
        } else {
            root.focused-child-count = Math.max(0, root.focused-child-count - 1);
        }
        root.sidebar-focus-changed(root.focused-child-count > 0);
    }

    preferred-width: 226px;
    background: OnyxTheme.bg-sidebar;
    clip: true;

    ScrollView {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: 10px;
            spacing: 12px;
            alignment: start;

            // Home button
            SidebarNavRow {
                label: "Home";
                icon-glyph: "home";
                icon: root.home-icon;
                has-icon: root.has-home-icon;
                active: root.current-path == root.home-path && root.home-path != "";
                clicked => { root.navigate-to(root.active-pane, root.home-path); }
                focus-changed(f) => { root.handle-child-focus(f); }
            }

            // Favorites section ("favorites")
            VerticalLayout {
                spacing: 3px;

                SidebarSectionHeader {
                    label: "FAVORITES";
                    collapsed: root.favorites-collapsed;
                    toggle => { root.toggle-group("favorites"); }
                    focus-changed(f) => { root.handle-child-focus(f); }
                }

                if !root.favorites-collapsed && root.favorites.length == 0 : Text {
                    text: "Pin folders from the address bar";
                    font-size: OnyxTheme.font-xs;
                    color: OnyxTheme.text-muted;
                    horizontal-alignment: left;
                }

                if !root.favorites-collapsed : VerticalLayout {
                    spacing: 3px;

                    for fav in root.favorites : SidebarNavRow {
                        label: fav.label;
                        icon-glyph: fav.icon_glyph != "" ? fav.icon_glyph : "star-filled";
                        icon: fav.icon;
                        has-icon: fav.has_icon;
                        active: root.current-path == fav.path;
                        removable: true;
                        clicked => { root.navigate-to(root.active-pane, fav.path); }
                        remove-clicked => { root.unpin-favorite(fav.path); }
                        focus-changed(f) => { root.handle-child-focus(f); }
                    }
                }
            }

            // Quick Access (Known Folders) section ("quick_access")
            VerticalLayout {
                spacing: 3px;

                SidebarSectionHeader {
                    label: "QUICK ACCESS";
                    collapsed: root.quick-access-collapsed;
                    toggle => { root.toggle-group("quick_access"); }
                    focus-changed(f) => { root.handle-child-focus(f); }
                }

                if !root.quick-access-collapsed : VerticalLayout {
                    spacing: 3px;

                    for folder in root.known-folders : SidebarNavRow {
                        label: folder.label;
                        icon-glyph: folder.icon_glyph != "" ? folder.icon_glyph : "folder";
                        icon: folder.icon;
                        has-icon: folder.has_icon;
                        active: root.current-path == folder.path;
                        clicked => { root.navigate-to(root.active-pane, folder.path); }
                        focus-changed(f) => { root.handle-child-focus(f); }
                    }
                }
            }

            // Drives section ("drives")
            VerticalLayout {
                spacing: 6px;

                SidebarSectionHeader {
                    label: "DRIVES";
                    collapsed: root.drives-collapsed;
                    toggle => { root.toggle-group("drives"); }
                    focus-changed(f) => { root.handle-child-focus(f); }
                }

                if !root.drives-collapsed : VerticalLayout {
                    spacing: 6px;

                    for drive in root.drives : Rectangle {
                        border-radius: OnyxTheme.radius-md;
                        border-width: drive-fs.has-focus ? 1.5px : 1px;
                        border-color: drive-fs.has-focus
                            ? OnyxTheme.border-focus
                            : (root.current-path == drive.root
                                ? OnyxTheme.accent-border
                                : (drive-ta.has-hover ? OnyxTheme.border-strong : OnyxTheme.border-subtle));
                        background: root.current-path == drive.root
                            ? OnyxTheme.bg-selected
                            : (drive-ta.has-hover ? OnyxTheme.bg-hover : OnyxTheme.bg-surface-alt);

                        animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }

                        accessible-role: button;
                        accessible-label: drive.label + " " + drive.free_label;

                        drive-fs := FocusScope {
                            width: parent.width;
                            height: parent.height;

                            changed has-focus => {
                                root.handle-child-focus(self.has-focus);
                            }

                            key-pressed(event) => {
                                if event.text == " " || event.text == Key.Return {
                                    root.navigate-to(root.active-pane, drive.root);
                                    return accept;
                                }
                                return reject;
                            }

                            drive-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.navigate-to(root.active-pane, drive.root); }
                            }
                        }

                        VerticalLayout {
                            padding: 8px;
                            spacing: 5px;

                            HorizontalLayout {
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;
                                    width: 20px;

                                    if drive.has_icon : Image {
                                        width: 20px;
                                        height: 20px;
                                        source: drive.icon;
                                        image-fit: contain;
                                    }

                                    if !drive.has_icon : OnyxIcon {
                                        name: "drive";
                                        size: 18px;
                                        icon-color: OnyxTheme.accent-bright;
                                    }
                                }

                                Text {
                                    text: drive.label;
                                    font-size: OnyxTheme.font-sm;
                                    font-weight: 600;
                                    color: OnyxTheme.text-primary;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                if drive.filesystem != "" : Rectangle {
                                    height: 16px;
                                    border-radius: 3px;
                                    background: OnyxTheme.bg-badge;

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: drive.filesystem;
                                            font-size: OnyxTheme.font-xs;
                                            font-weight: 600;
                                            color: OnyxTheme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Usage progress bar
                            Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: OnyxTheme.border-subtle;
                                clip: true;

                                accessible-role: progress-indicator;
                                accessible-value-minimum: 0;
                                accessible-value-maximum: 100;
                                accessible-value: Math.round(Math.clamp(drive.usage_ratio, 0.0, 1.0) * 100) + "%";

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    height: parent.height;
                                    width: parent.width * Math.clamp(drive.usage_ratio, 0.0, 1.0);
                                    border-radius: 2px;
                                    background: drive.usage_ratio > 0.90
                                        ? OnyxTheme.danger
                                        : OnyxTheme.accent-bright;
                                }
                            }

                            Text {
                                text: drive.free_label;
                                font-size: OnyxTheme.font-sm;
                                font-weight: 600;
                                color: OnyxTheme.text-primary;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
