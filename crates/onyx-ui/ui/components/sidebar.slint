import { ScrollView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiSidebarItem, UiDriveItem } from "../types.slint";
import { OnyxIcon } from "icons.slint";

component SidebarSectionHeader inherits Text {
    font-size: OnyxTheme.font-xs;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: OnyxTheme.text-muted;
}

component SidebarNavRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-glyph: "folder";
    in property <bool> active: false;
    in property <bool> removable: false;

    callback clicked();
    callback remove-clicked();

    height: 30px;
    border-radius: OnyxTheme.radius-sm;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? OnyxTheme.accent-border : transparent;
    background: root.active
        ? OnyxTheme.bg-selected
        : (row-ta.has-hover ? OnyxTheme.bg-hover : transparent);

    animate background { duration: 100ms; }

    accessible-role: button;
    accessible-label: root.label;

    // Luminous violet active left indicator bar
    if root.active : Rectangle {
        x: 2px;
        y: 7px;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: OnyxTheme.accent-bright;
    }

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            width: 18px;

            OnyxIcon {
                name: root.icon-glyph != "" ? root.icon-glyph : "folder";
                icon-color: root.active ? OnyxTheme.accent-bright : OnyxTheme.text-secondary;
            }
        }

        Text {
            text: root.label;
            font-size: OnyxTheme.font-sm;
            font-weight: root.active ? 600 : 400;
            color: root.active ? OnyxTheme.text-primary : OnyxTheme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.removable : Rectangle {
            width: 20px;
            height: 20px;
            y: 5px;
            opacity: (row-ta.has-hover || unpin-ta.has-hover) ? 1.0 : 0.35;
            border-radius: OnyxTheme.radius-sm;
            background: unpin-ta.has-hover ? OnyxTheme.bg-pressed : transparent;
            accessible-role: button;
            accessible-label: "Unpin " + root.label;

            OnyxIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "close";
                icon-color: OnyxTheme.text-muted;
            }

            unpin-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove-clicked(); }
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <int> active-pane: 0;
    in property <string> current-path: "";
    in property <string> home-path: "";
    in property <[UiSidebarItem]> favorites;
    in property <[UiSidebarItem]> known-folders;
    in property <[UiDriveItem]> drives;

    callback navigate-to(int, string);
    callback unpin-favorite(string);

    width: 226px;
    background: OnyxTheme.bg-sidebar;

    // Right subtle border
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: OnyxTheme.border-sidebar;
    }

    ScrollView {
        width: parent.width - 1px;
        height: parent.height;

        VerticalLayout {
            padding: 10px;
            spacing: 14px;
            alignment: start;

            // Home button
            SidebarNavRow {
                label: "Home";
                icon-glyph: "home";
                active: root.current-path == root.home-path && root.home-path != "";
                clicked => { root.navigate-to(root.active-pane, root.home-path); }
            }

            // Favorites section
            VerticalLayout {
                spacing: 3px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 2px;
                    SidebarSectionHeader { text: "FAVORITES"; }
                }

                if root.favorites.length == 0 : Text {
                    text: "Pin folders from the address bar";
                    font-size: OnyxTheme.font-xs;
                    color: OnyxTheme.text-muted;
                    horizontal-alignment: left;
                }

                for fav in root.favorites : SidebarNavRow {
                    label: fav.label;
                    icon-glyph: fav.icon_glyph != "" ? fav.icon_glyph : "star-filled";
                    active: root.current-path == fav.path;
                    removable: true;
                    clicked => { root.navigate-to(root.active-pane, fav.path); }
                    remove-clicked => { root.unpin-favorite(fav.path); }
                }
            }

            // Quick Access (Known Folders) section
            VerticalLayout {
                spacing: 3px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 2px;
                    SidebarSectionHeader { text: "QUICK ACCESS"; }
                }

                for folder in root.known-folders : SidebarNavRow {
                    label: folder.label;
                    icon-glyph: folder.icon_glyph != "" ? folder.icon_glyph : "folder";
                    active: root.current-path == folder.path;
                    clicked => { root.navigate-to(root.active-pane, folder.path); }
                }
            }

            // Drives section
            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 2px;
                    SidebarSectionHeader { text: "DRIVES"; }
                }

                for drive in root.drives : Rectangle {
                    border-radius: OnyxTheme.radius-md;
                    border-width: 1px;
                    border-color: root.current-path == drive.root
                        ? OnyxTheme.accent-border
                        : (drive-ta.has-hover ? OnyxTheme.border-strong : OnyxTheme.border-subtle);
                    background: root.current-path == drive.root
                        ? OnyxTheme.bg-selected
                        : (drive-ta.has-hover ? OnyxTheme.bg-hover : OnyxTheme.bg-surface-alt);

                    animate background { duration: 100ms; }

                    accessible-role: button;
                    accessible-label: drive.label + " " + drive.free_label;

                    drive-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.navigate-to(root.active-pane, drive.root); }
                    }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 5px;

                        HorizontalLayout {
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                OnyxIcon {
                                    name: "drive";
                                    icon-color: OnyxTheme.accent-bright;
                                }
                            }

                            Text {
                                text: drive.label;
                                font-size: OnyxTheme.font-sm;
                                font-weight: 600;
                                color: OnyxTheme.text-primary;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            if drive.filesystem != "" : Rectangle {
                                height: 16px;
                                border-radius: 3px;
                                background: OnyxTheme.bg-badge;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: drive.filesystem;
                                        font-size: OnyxTheme.font-xs;
                                        font-weight: 600;
                                        color: OnyxTheme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Usage progress bar
                        Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: OnyxTheme.border-subtle;
                            clip: true;

                            accessible-role: progress-indicator;
                            accessible-value-minimum: 0;
                            accessible-value-maximum: 100;
                            accessible-value: Math.round(Math.clamp(drive.usage_ratio, 0.0, 1.0) * 100) + "%";

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                height: parent.height;
                                width: parent.width * Math.clamp(drive.usage_ratio, 0.0, 1.0);
                                border-radius: 2px;
                                background: drive.usage_ratio > 0.90
                                    ? OnyxTheme.danger
                                    : (drive.usage_ratio > 0.78 ? OnyxTheme.warning : OnyxTheme.accent-effective);
                            }
                        }

                        Text {
                            text: drive.free_label;
                            font-size: OnyxTheme.font-xs;
                            color: OnyxTheme.text-muted;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
