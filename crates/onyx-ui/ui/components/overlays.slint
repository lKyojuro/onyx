import { LineEdit, ListView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiCommandItem, UiMetadataRow, UiOperationProgress } from "../types.slint";
import { FluentButton, FluentChip, HorizontalDivider } from "common.slint";
import { OnyxIcon } from "icons.slint";
import { PreviewPane } from "preview_pane.slint";

// Command Palette Modal (Ctrl+K)
export component CommandPaletteModal inherits Rectangle {
    in property <bool> open: false;
    in-out property <string> query: "";
    in property <[UiCommandItem]> items;
    in-out property <int> selected-index: 0;

    callback query-changed(string);
    callback execute-command(string);
    callback close();

    public function focus-input() {
        root.selected-index = 0;
        cmd-input.focus();
    }

    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: OnyxTheme.bg-backdrop;
    animate opacity { duration: 140ms; easing: ease-out; }

    // Click outside to dismiss
    TouchArea {
        clicked => { root.close(); }
    }

    // Top-centered elevated Nocturne card
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 68px;
        width: Math.min(560px, parent.width - 48px);
        height: Math.min(420px, parent.height - 120px);
        border-radius: OnyxTheme.radius-lg;
        border-width: 1px;
        border-color: OnyxTheme.border-strong;
        background: OnyxTheme.bg-elevated;
        clip: true;

        // Subtle specular top highlight
        Rectangle {
            x: 12px;
            y: 1px;
            width: parent.width - 24px;
            height: 1px;
            background: OnyxTheme.border-specular;
        }

        // Absorb clicks inside modal
        TouchArea { }

        FocusScope {
            width: parent.width;
            height: parent.height;

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                if event.text == Key.DownArrow && root.items.length > 0 {
                    root.selected-index = Math.min(root.items.length - 1, root.selected-index + 1);
                    return accept;
                }
                if event.text == Key.UpArrow && root.items.length > 0 {
                    root.selected-index = Math.max(0, root.selected-index - 1);
                    return accept;
                }
                if event.text == Key.Return && root.items.length > 0 {
                    root.execute-command(root.items[Math.clamp(root.selected-index, 0, root.items.length - 1)].id);
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                spacing: 0px;

                // Search input header
                HorizontalLayout {
                    padding: 12px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        OnyxIcon {
                            name: "command";
                            icon-color: OnyxTheme.accent-bright;
                        }
                    }

                    cmd-input := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.query;
                        placeholder-text: "Type a command or action...";
                        font-size: OnyxTheme.font-md;
                        edited(text) => {
                            root.selected-index = 0;
                            root.query-changed(text);
                        }
                        accepted(_) => {
                            if root.items.length > 0 {
                                root.execute-command(root.items[Math.clamp(root.selected-index, 0, root.items.length - 1)].id);
                            }
                        }
                    }

                    FluentChip {
                        y: 4px;
                        label: "Esc";
                        interactive: true;
                        a11y-label: "Close command palette";
                        clicked => { root.close(); }
                    }
                }

                HorizontalDivider { }

                // Empty results notice
                if root.items.length == 0 : Rectangle {
                    vertical-stretch: 1;

                    Text {
                        text: "No matching commands";
                        font-size: OnyxTheme.font-sm;
                        color: OnyxTheme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Filtered command list
                if root.items.length > 0 : ListView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: "Command palette results";

                    for cmd[idx] in root.items : Rectangle {
                        height: 40px;
                        background: transparent;

                        Rectangle {
                            x: 8px;
                            y: 2px;
                            width: parent.width - 16px;
                            height: parent.height - 4px;
                            border-radius: OnyxTheme.radius-sm;
                            border-width: idx == root.selected-index ? 1px : 0px;
                            border-color: OnyxTheme.accent-border;
                            background: idx == root.selected-index
                                ? OnyxTheme.bg-selected
                                : (cmd-ta.has-hover ? OnyxTheme.bg-hover : transparent);

                            accessible-role: button;
                            accessible-label: cmd.title;

                            cmd-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.execute-command(cmd.id); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                if cmd.category != "" : FluentChip {
                                    y: 7px;
                                    label: cmd.category;
                                    interactive: false;
                                }

                                Text {
                                    text: cmd.title;
                                    font-size: OnyxTheme.font-sm;
                                    font-weight: idx == root.selected-index ? 600 : 400;
                                    color: OnyxTheme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                if cmd.shortcut != "" : Rectangle {
                                    height: 22px;
                                    y: 7px;
                                    border-radius: OnyxTheme.radius-sm;
                                    border-width: 1px;
                                    border-color: OnyxTheme.border-subtle;
                                    background: OnyxTheme.bg-code;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;

                                        Text {
                                            text: cmd.shortcut;
                                            font-family: OnyxTheme.font-mono;
                                            font-size: OnyxTheme.font-xs;
                                            color: OnyxTheme.accent-bright;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Reusable Prompt Dialog Modal (New Folder, Rename, Permanent Delete confirmation)
export component PromptDialogModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> title: "";
    in property <string> message: "";
    in-out property <string> input-text: "";
    in property <bool> show-input: true;
    in property <string> confirm-label: "Confirm";
    in property <bool> is-danger: false;

    callback confirm(string);
    callback cancel();

    public function focus-input() {
        if root.show-input {
            dialog-input.focus();
        } else {
            dialog-scope.focus();
        }
    }

    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: OnyxTheme.bg-backdrop;
    animate opacity { duration: 140ms; easing: ease-out; }

    TouchArea {
        clicked => { root.cancel(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(440px, parent.width - 48px);
        border-radius: OnyxTheme.radius-lg;
        border-width: 1px;
        border-color: root.is-danger ? OnyxTheme.danger : OnyxTheme.border-strong;
        background: OnyxTheme.bg-elevated;

        // Subtle specular top highlight
        Rectangle {
            x: 12px;
            y: 1px;
            width: parent.width - 24px;
            height: 1px;
            background: OnyxTheme.border-specular;
        }

        TouchArea { }

        dialog-scope := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel();
                    return accept;
                }
                if event.text == Key.Return {
                    root.confirm(root.input-text);
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 8px;

                    if root.is-danger : VerticalLayout {
                        alignment: center;
                        OnyxIcon {
                            name: "warning";
                            icon-color: OnyxTheme.danger;
                        }
                    }

                    Text {
                        text: root.title;
                        font-size: OnyxTheme.font-lg;
                        font-weight: 600;
                        color: root.is-danger ? OnyxTheme.danger : OnyxTheme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                if root.message != "" : Text {
                    text: root.message;
                    font-size: OnyxTheme.font-sm;
                    color: OnyxTheme.text-secondary;
                    wrap: word-wrap;
                }

                Rectangle {
                    visible: root.show-input;
                    height: root.show-input ? 32px : 0px;
                    clip: true;

                    dialog-input := LineEdit {
                        width: parent.width;
                        height: 32px;
                        text <=> root.input-text;
                        font-size: OnyxTheme.font-md;
                        accepted(text) => { root.confirm(text); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    FluentButton {
                        label: "Cancel";
                        a11y-label: "Cancel dialog";
                        clicked => { root.cancel(); }
                    }

                    FluentButton {
                        label: root.confirm-label != "" ? root.confirm-label : "Confirm";
                        a11y-label: root.confirm-label != "" ? root.confirm-label : "Confirm dialog";
                        primary: true;
                        danger: root.is-danger;
                        clicked => { root.confirm(root.input-text); }
                    }
                }
            }
        }
    }
}

// Spacebar Quick Look Modal Overlay
export component QuickLookModal inherits Rectangle {
    in property <bool> open: false;
    in property <string> preview-title: "";
    in property <string> preview-subtitle: "";
    in property <string> preview-kind: "none";
    in property <image> preview-image;
    in property <bool> has-preview-image: false;
    in property <string> preview-text: "";
    in property <string> preview-language: "";
    in property <bool> preview-truncated: false;
    in property <string> preview-summary: "";
    in property <string> preview-error: "";
    in property <[UiMetadataRow]> preview-metadata;

    callback close();
    callback open-item();

    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    background: OnyxTheme.bg-backdrop;
    animate opacity { duration: 140ms; easing: ease-out; }

    TouchArea {
        clicked => { root.close(); }
    }

    PreviewPane {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(860px, parent.width - 80px);
        height: Math.min(640px, parent.height - 80px);
        is-quick-look: true;
        preview-title: root.preview-title;
        preview-subtitle: root.preview-subtitle;
        preview-kind: root.preview-kind;
        preview-image: root.preview-image;
        has-preview-image: root.has-preview-image;
        preview-text: root.preview-text;
        preview-language: root.preview-language;
        preview-truncated: root.preview-truncated;
        preview-summary: root.preview-summary;
        preview-error: root.preview-error;
        preview-metadata: root.preview-metadata;
        close-preview => { root.close(); }
        open-item => { root.open-item(); }
    }
}

// Bottom-Right Floating Operation Progress Card
export component OperationProgressCard inherits Rectangle {
    in property <UiOperationProgress> operation;

    callback cancel-operation();

    property <float> clamped-progress: Math.clamp(root.operation.progress, 0.0, 1.0);

    width: 336px;
    border-radius: OnyxTheme.radius-lg;
    border-width: 1px;
    border-color: OnyxTheme.border-strong;
    background: OnyxTheme.bg-elevated;

    Rectangle {
        x: 12px;
        y: 1px;
        width: parent.width - 24px;
        height: 1px;
        background: OnyxTheme.border-specular;
    }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                text: root.operation.title != "" ? root.operation.title : "Running operation...";
                font-size: OnyxTheme.font-sm;
                font-weight: 600;
                color: OnyxTheme.text-primary;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: Math.round(root.clamped-progress * 100) + "%";
                font-family: OnyxTheme.font-mono;
                font-size: OnyxTheme.font-xs;
                font-weight: 600;
                color: OnyxTheme.accent-bright;
                vertical-alignment: center;
            }
        }

        if root.operation.current_item != "" : Text {
            text: root.operation.current_item;
            font-size: OnyxTheme.font-xs;
            color: OnyxTheme.text-secondary;
            overflow: elide;
        }

        // Progress bar track
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: OnyxTheme.border-subtle;
            clip: true;

            accessible-role: progress-indicator;
            accessible-label: root.operation.title;
            accessible-value-minimum: 0;
            accessible-value-maximum: 100;
            accessible-value: Math.round(root.clamped-progress * 100) + "%";

            Rectangle {
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parent.width * root.clamped-progress;
                border-radius: 3px;
                background: OnyxTheme.accent-effective;
                animate width { duration: 120ms; easing: ease-out; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            Text {
                text: root.operation.detail;
                font-size: OnyxTheme.font-xs;
                color: OnyxTheme.text-muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            FluentButton {
                label: "Cancel";
                a11y-label: "Cancel file operation";
                compact: true;
                danger: true;
                clicked => { root.cancel-operation(); }
            }
        }
    }
}
