import { ListView } from "std-widgets.slint";
import { OnyxTheme } from "../tokens.slint";
import { UiArchiveEntry } from "../types.slint";
import { FluentButton, FluentChip, HorizontalDivider } from "common.slint";
import { OnyxIcon, OnyxIconSize } from "icons.slint";

export component ArchiveBrowserModal inherits Rectangle {
    in property <string> archive-title: "";
    in property <string> archive-path: "";
    in property <string> archive-summary: "";
    in property <bool> is-loading: false;
    in property <string> error-message: "";
    in property <[UiArchiveEntry]> entries;

    callback extract-here();
    callback extract-to-folder();
    callback close();

    public function focus-panel() {
        archive-scope.focus();
    }

    background: OnyxTheme.bg-backdrop;

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Math.min(720px, parent.width - 56px);
        height: Math.min(540px, parent.height - 72px);
        border-radius: OnyxTheme.radius-lg;
        border-width: 1px;
        border-color: OnyxTheme.border-strong;
        background: OnyxTheme.bg-elevated;
        clip: true;

        // Specular top edge
        Rectangle {
            x: 12px;
            y: 1px;
            width: parent.width - 24px;
            height: 1px;
            background: OnyxTheme.border-specular;
        }

        // Absorb clicks inside modal
        TouchArea { }

        archive-scope := FocusScope {
            width: parent.width;
            height: parent.height;

            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                spacing: 0px;

                // Header
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            OnyxIcon {
                                name: "archive";
                                size: 20px;
                                icon-color: OnyxTheme.accent-bright;
                            }
                        }

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            alignment: center;

                            Text {
                                text: root.archive-title != "" ? root.archive-title : "ZIP Archive";
                                font-size: OnyxTheme.font-lg;
                                font-weight: 600;
                                color: OnyxTheme.text-primary;
                                overflow: elide;
                            }

                            Text {
                                text: root.archive-summary != "" ? root.archive-summary : root.archive-path;
                                font-size: OnyxTheme.font-xs;
                                color: OnyxTheme.text-muted;
                                overflow: elide;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        FluentChip {
                            y: 3px;
                            label: "Esc";
                            interactive: true;
                            a11y-label: "Close archive browser";
                            clicked => { root.close(); }
                        }

                        FluentButton {
                            icon-name: "close";
                            a11y-label: "Close archive browser";
                            compact: true;
                            clicked => { root.close(); }
                        }
                    }
                }

                HorizontalDivider { }

                // Column Headers
                if !root.is-loading && root.error-message == "" && root.entries.length > 0 : Rectangle {
                    height: 28px;
                    background: OnyxTheme.bg-surface-alt;

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: OnyxTheme.border-subtle;
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 18px;
                        spacing: 8px;

                        Text {
                            text: "Path";
                            font-size: OnyxTheme.font-xs;
                            font-weight: 600;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "Size";
                            font-size: OnyxTheme.font-xs;
                            font-weight: 600;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 78px;
                        }

                        Text {
                            text: "Packed";
                            font-size: OnyxTheme.font-xs;
                            font-weight: 600;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            width: 78px;
                        }

                        Text {
                            text: "Modified";
                            font-size: OnyxTheme.font-xs;
                            font-weight: 600;
                            color: OnyxTheme.text-muted;
                            vertical-alignment: center;
                            width: 126px;
                        }
                    }
                }

                // Loading state
                if root.is-loading : Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            OnyxIcon {
                                name: "refresh";
                                size: 24px;
                                icon-color: OnyxTheme.accent-bright;
                            }
                        }

                        Text {
                            text: "Inspecting archive entries...";
                            font-size: OnyxTheme.font-sm;
                            color: OnyxTheme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Error state
                if !root.is-loading && root.error-message != "" : Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        padding: 24px;

                        Rectangle {
                            border-radius: OnyxTheme.radius-md;
                            border-width: 1px;
                            border-color: OnyxTheme.danger;
                            background: OnyxTheme.danger-bg;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                Text {
                                    text: "Unable to read archive";
                                    font-size: OnyxTheme.font-md;
                                    font-weight: 600;
                                    color: OnyxTheme.danger;
                                }

                                Text {
                                    text: root.error-message;
                                    font-size: OnyxTheme.font-sm;
                                    color: OnyxTheme.text-primary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Empty archive state
                if !root.is-loading && root.error-message == "" && root.entries.length == 0 : Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "This archive is empty.";
                            font-size: OnyxTheme.font-md;
                            color: OnyxTheme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Entries List
                if !root.is-loading && root.error-message == "" && root.entries.length > 0 : ListView {
                    vertical-stretch: 1;
                    accessible-role: list;
                    accessible-label: "Archive entries";

                    for item in root.entries : Rectangle {
                        height: 30px;
                        background: transparent;

                        Rectangle {
                            x: 6px;
                            y: 1px;
                            width: parent.width - 12px;
                            height: parent.height - 2px;
                            border-radius: OnyxTheme.radius-sm;
                            background: row-ta.has-hover ? OnyxTheme.bg-hover : transparent;

                            row-ta := TouchArea { }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 8px;

                                    VerticalLayout {
                                        alignment: center;
                                        OnyxIcon {
                                            name: item.is_dir ? "folder" : "file";
                                            size: OnyxIconSize.small;
                                            icon-color: item.is_dir ? OnyxTheme.folder-tint : OnyxTheme.file-tint;
                                        }
                                    }

                                    Text {
                                        text: item.relative_path;
                                        font-family: OnyxTheme.font-mono;
                                        font-size: OnyxTheme.font-xs;
                                        font-weight: item.is_dir ? 600 : 400;
                                        color: OnyxTheme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Text {
                                    text: item.size_label;
                                    font-size: OnyxTheme.font-xs;
                                    color: OnyxTheme.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 78px;
                                }

                                Text {
                                    text: item.compressed_label;
                                    font-size: OnyxTheme.font-xs;
                                    color: OnyxTheme.text-muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 78px;
                                }

                                Text {
                                    text: item.modified;
                                    font-size: OnyxTheme.font-xs;
                                    color: OnyxTheme.text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    width: 126px;
                                }
                            }
                        }
                    }
                }

                HorizontalDivider { }

                // Footer action bar
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: root.archive-path;
                        font-size: OnyxTheme.font-xs;
                        color: OnyxTheme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;

                        FluentButton {
                            icon-name: "extract";
                            label: "Extract Here";
                            enabled: !root.is-loading && root.error-message == "";
                            clicked => { root.extract-here(); }
                        }

                        FluentButton {
                            icon-name: "folder-plus";
                            label: "Extract to Folder";
                            primary: true;
                            enabled: !root.is-loading && root.error-message == "";
                            clicked => { root.extract-to-folder(); }
                        }

                        FluentButton {
                            label: "Close";
                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }
    }
}
