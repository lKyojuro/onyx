        ArcTo { x: 16; y: 12; radius-x: 4; radius-y: 4; sweep: true; large-arc: false; }
        MoveTo { x: 12; y: 2; } LineTo { x: 12; y: 4.5; }
        MoveTo { x: 12; y: 19.5; } LineTo { x: 12; y: 22; }
        MoveTo { x: 2; y: 12; } LineTo { x: 4.5; y: 12; }
        MoveTo { x: 19.5; y: 12; } LineTo { x: 22; y: 12; }
        MoveTo { x: 4.9; y: 4.9; } LineTo { x: 6.7; y: 6.7; }
        MoveTo { x: 17.3; y: 17.3; } LineTo { x: 19.1; y: 19.1; }
        MoveTo { x: 19.1; y: 4.9; } LineTo { x: 17.3; y: 6.7; }
