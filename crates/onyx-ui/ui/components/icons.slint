        MoveTo { x: 9; y: 9; } LineTo { x: 15; y: 9; } LineTo { x: 15; y: 15; } LineTo { x: 9; y: 15; } Close { }
        MoveTo { x: 9; y: 9; } LineTo { x: 9; y: 5; } LineTo { x: 5; y: 5; } LineTo { x: 5; y: 9; } Close { }
        MoveTo { x: 15; y: 9; } LineTo { x: 19; y: 9; } LineTo { x: 19; y: 5; } LineTo { x: 15; y: 5; } Close { }
        MoveTo { x: 9; y: 15; } LineTo { x: 5; y: 15; } LineTo { x: 5; y: 19; } LineTo { x: 9; y: 19; } Close { }
        MoveTo { x: 15; y: 15; } LineTo { x: 15; y: 19; } LineTo { x: 19; y: 19; } LineTo { x: 19; y: 15; } Close { }
