        MoveTo { x: 20; y: 14.5; }
        ArcTo { x: 9.5; y: 4; radius-x: 8.5; radius-y: 8.5; sweep: true; large-arc: true; }
        ArcTo { x: 20; y: 14.5; radius-x: 6.5; radius-y: 6.5; sweep: false; large-arc: false; }
