        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 9; y: 4; } LineTo { x: 15; y: 4; } LineTo { x: 15; y: 7; } LineTo { x: 9; y: 7; } Close { }
        MoveTo { x: 9; y: 5.5; } LineTo { x: 5; y: 5.5; } LineTo { x: 5; y: 20; } LineTo { x: 19; y: 20; } LineTo { x: 19; y: 5.5; } LineTo { x: 15; y: 5.5; }
    }

    // Rename (pencil)
    if name == "rename" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 16.5; y: 3.5; } LineTo { x: 20.5; y: 7.5; } LineTo { x: 8; y: 20; }
        LineTo { x: 4; y: 20; } LineTo { x: 4; y: 16; } Close { }
    }

    // Duplicate (layers)
    if name == "duplicate" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 3; } LineTo { x: 21; y: 8; } LineTo { x: 12; y: 13; } LineTo { x: 3; y: 8; } Close { }
        MoveTo { x: 3; y: 13; } LineTo { x: 12; y: 18; } LineTo { x: 21; y: 13; }
        MoveTo { x: 3; y: 17; } LineTo { x: 12; y: 22; } LineTo { x: 21; y: 17; }
    }

    // Trash / Recycle
    if name == "trash" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 4; y: 7; } LineTo { x: 20; y: 7; }
        MoveTo { x: 9; y: 7; } LineTo { x: 9; y: 4; } LineTo { x: 15; y: 4; } LineTo { x: 15; y: 7; }
        MoveTo { x: 6; y: 7; } LineTo { x: 7; y: 20; } LineTo { x: 17; y: 20; } LineTo { x: 18; y: 7; }
        MoveTo { x: 10; y: 11; } LineTo { x: 10; y: 16; }
        MoveTo { x: 14; y: 11; } LineTo { x: 14; y: 16; }
    }

    // Undo
    if name == "undo" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 9; y: 14; } LineTo { x: 4; y: 9; } LineTo { x: 9; y: 4; }
        MoveTo { x: 4; y: 9; } LineTo { x: 15; y: 9; }
        ArcTo { x: 15; y: 20; radius-x: 5.5; radius-y: 5.5; sweep: true; large-arc: false; }
        LineTo { x: 11; y: 20; }
    }

    // Details list view
    if name == "list" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 4; y: 6; } LineTo { x: 20; y: 6; }
        MoveTo { x: 4; y: 12; } LineTo { x: 20; y: 12; }
        MoveTo { x: 4; y: 18; } LineTo { x: 20; y: 18; }
    }

    // Grid view
    if name == "grid" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 4; y: 4; } LineTo { x: 10; y: 4; } LineTo { x: 10; y: 10; } LineTo { x: 4; y: 10; } Close { }
        MoveTo { x: 14; y: 4; } LineTo { x: 20; y: 4; } LineTo { x: 20; y: 10; } LineTo { x: 14; y: 10; } Close { }
        MoveTo { x: 4; y: 14; } LineTo { x: 10; y: 14; } LineTo { x: 10; y: 20; } LineTo { x: 4; y: 20; } Close { }
        MoveTo { x: 14; y: 14; } LineTo { x: 20; y: 14; } LineTo { x: 20; y: 20; } LineTo { x: 14; y: 20; } Close { }
