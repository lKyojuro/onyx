        MoveTo { x: 3; y: 4; } LineTo { x: 21; y: 4; } LineTo { x: 21; y: 16; } LineTo { x: 3; y: 16; } Close { }
        MoveTo { x: 8; y: 20; } LineTo { x: 16; y: 20; }
        MoveTo { x: 12; y: 16; } LineTo { x: 12; y: 20; }
    }

    // Downloads
    if name == "download" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 3; } LineTo { x: 12; y: 15; }
        MoveTo { x: 7; y: 10; } LineTo { x: 12; y: 15; } LineTo { x: 17; y: 10; }
        MoveTo { x: 4; y: 17; } LineTo { x: 4; y: 20; } LineTo { x: 20; y: 20; } LineTo { x: 20; y: 17; }
    }

    // Pictures / Image
    if name == "image" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 3; y: 4; } LineTo { x: 21; y: 4; } LineTo { x: 21; y: 20; } LineTo { x: 3; y: 20; } Close { }
        MoveTo { x: 4; y: 17; } LineTo { x: 9.5; y: 11.5; } LineTo { x: 14; y: 16; } LineTo { x: 16.5; y: 13.5; } LineTo { x: 20.5; y: 17.5; }
        MoveTo { x: 9.5; y: 8.5; } LineTo { x: 9.6; y: 8.5; }
    }

    // Warning triangle
    if name == "warning" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 3; } LineTo { x: 21.5; y: 20; } LineTo { x: 2.5; y: 20; } Close { }
        MoveTo { x: 12; y: 9.5; } LineTo { x: 12; y: 14; }
        MoveTo { x: 12; y: 17; } LineTo { x: 12.1; y: 17; }
    }
}
