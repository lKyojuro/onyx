import { OnyxTheme } from "../tokens.slint";

// Crisp Lucide-style 24x24 vector icons for Onyx UI
export component OnyxIcon inherits Rectangle {
    in property <string> name: "";
    in property <length> size: 15px;
    in property <color> icon-color: OnyxTheme.text-primary;
    in property <length> stroke-w: 1.6px;

    width: size;
    height: size;
    background: transparent;

    // Back arrow
    if name == "back" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 19; y: 12; } LineTo { x: 5; y: 12; }
        MoveTo { x: 12; y: 19; } LineTo { x: 5; y: 12; } LineTo { x: 12; y: 5; }
    }

    // Forward arrow
    if name == "forward" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 5; y: 12; } LineTo { x: 19; y: 12; }
        MoveTo { x: 12; y: 5; } LineTo { x: 19; y: 12; } LineTo { x: 12; y: 19; }
    }

    // Up arrow
    if name == "up" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 19; } LineTo { x: 12; y: 5; }
        MoveTo { x: 5; y: 12; } LineTo { x: 12; y: 5; } LineTo { x: 19; y: 12; }
    }

    // Refresh
    if name == "refresh" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 21; y: 12; }
        ArcTo { x: 12; y: 3; radius-x: 9; radius-y: 9; sweep: false; large-arc: false; }
        ArcTo { x: 5.6; y: 5.6; radius-x: 9; radius-y: 9; sweep: false; large-arc: false; }
        MoveTo { x: 3; y: 12; }
        ArcTo { x: 12; y: 21; radius-x: 9; radius-y: 9; sweep: false; large-arc: false; }
        ArcTo { x: 18.4; y: 18.4; radius-x: 9; radius-y: 9; sweep: false; large-arc: false; }
        MoveTo { x: 21; y: 5; } LineTo { x: 21; y: 11; } LineTo { x: 15; y: 11; }
    }

    // Plus
    if name == "plus" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 5; } LineTo { x: 12; y: 19; }
        MoveTo { x: 5; y: 12; } LineTo { x: 19; y: 12; }
    }

    // Close X
    if name == "close" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 18; y: 6; } LineTo { x: 6; y: 18; }
        MoveTo { x: 6; y: 6; } LineTo { x: 18; y: 18; }
    }

    // Search magnifier
    if name == "search" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 18; y: 11; }
        ArcTo { x: 4; y: 11; radius-x: 7; radius-y: 7; sweep: true; large-arc: false; }
        ArcTo { x: 18; y: 11; radius-x: 7; radius-y: 7; sweep: true; large-arc: false; }
        MoveTo { x: 20.5; y: 20.5; } LineTo { x: 16; y: 16; }
    }

    // Folder (outlined + subtle fill)
    if name == "folder" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color.transparentize(0.76);
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 3; y: 6; }
        LineTo { x: 9.5; y: 6; }
        LineTo { x: 11.5; y: 8.5; }
        LineTo { x: 21; y: 8.5; }
        LineTo { x: 21; y: 19; }
        LineTo { x: 3; y: 19; }
        Close { }
    }

    // Folder + Plus (New Folder)
    if name == "folder-plus" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 3; y: 6; } LineTo { x: 9.5; y: 6; } LineTo { x: 11.5; y: 8.5; }
        LineTo { x: 21; y: 8.5; } LineTo { x: 21; y: 19; } LineTo { x: 3; y: 19; } Close { }
        MoveTo { x: 12; y: 11.5; } LineTo { x: 12; y: 16.5; }
        MoveTo { x: 9.5; y: 14; } LineTo { x: 14.5; y: 14; }
    }

    // File document
    if name == "file" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color.transparentize(0.84);
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 6; y: 3; } LineTo { x: 14; y: 3; } LineTo { x: 19; y: 8; }
        LineTo { x: 19; y: 21; } LineTo { x: 6; y: 21; } Close { }
        MoveTo { x: 14; y: 3; } LineTo { x: 14; y: 8; } LineTo { x: 19; y: 8; }
    }

    // Home
    if name == "home" : Path {
        width: parent.width; height: parent.height;
