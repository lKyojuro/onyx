        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 3; y: 10.5; } LineTo { x: 12; y: 3; } LineTo { x: 21; y: 10.5; }
        MoveTo { x: 5; y: 9.5; } LineTo { x: 5; y: 20; } LineTo { x: 19; y: 20; } LineTo { x: 19; y: 9.5; }
        MoveTo { x: 9.5; y: 20; } LineTo { x: 9.5; y: 14; } LineTo { x: 14.5; y: 14; } LineTo { x: 14.5; y: 20; }
    }

    // Star (outline)
    if name == "star" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 3; } LineTo { x: 14.9; y: 8.8; } LineTo { x: 21.2; y: 9.7; }
        LineTo { x: 16.6; y: 14.2; } LineTo { x: 17.7; y: 20.5; } LineTo { x: 12; y: 17.5; }
        LineTo { x: 6.3; y: 20.5; } LineTo { x: 7.4; y: 14.2; } LineTo { x: 2.8; y: 9.7; }
        LineTo { x: 9.1; y: 8.8; } Close { }
    }

    // Star (filled)
    if name == "star-filled" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 12; y: 3; } LineTo { x: 14.9; y: 8.8; } LineTo { x: 21.2; y: 9.7; }
        LineTo { x: 16.6; y: 14.2; } LineTo { x: 17.7; y: 20.5; } LineTo { x: 12; y: 17.5; }
        LineTo { x: 6.3; y: 20.5; } LineTo { x: 7.4; y: 14.2; } LineTo { x: 2.8; y: 9.7; }
        LineTo { x: 9.1; y: 8.8; } Close { }
    }

    // Hard Drive
    if name == "drive" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 3; y: 14; } LineTo { x: 21; y: 14; } LineTo { x: 21; y: 19; } LineTo { x: 3; y: 19; } Close { }
        MoveTo { x: 3; y: 14; } LineTo { x: 6; y: 6; } LineTo { x: 18; y: 6; } LineTo { x: 21; y: 14; }
        MoveTo { x: 16.5; y: 16.5; } LineTo { x: 17.5; y: 16.5; }
    }

    // Cut (scissors)
    if name == "cut" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 20; y: 4; } LineTo { x: 8.5; y: 15.5; }
        MoveTo { x: 20; y: 20; } LineTo { x: 8.5; y: 8.5; }
        MoveTo { x: 9; y: 6.5; } ArcTo { x: 4; y: 6.5; radius-x: 2.5; radius-y: 2.5; sweep: true; large-arc: false; }
        ArcTo { x: 9; y: 6.5; radius-x: 2.5; radius-y: 2.5; sweep: true; large-arc: false; }
        MoveTo { x: 9; y: 17.5; } ArcTo { x: 4; y: 17.5; radius-x: 2.5; radius-y: 2.5; sweep: true; large-arc: false; }
        ArcTo { x: 9; y: 17.5; radius-x: 2.5; radius-y: 2.5; sweep: true; large-arc: false; }
    }

    // Copy
    if name == "copy" : Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: root.icon-color; stroke-width: root.stroke-w;
        stroke-line-cap: round; stroke-line-join: round;
        MoveTo { x: 9; y: 9; } LineTo { x: 20; y: 9; } LineTo { x: 20; y: 20; } LineTo { x: 9; y: 20; } Close { }
        MoveTo { x: 6; y: 15; } LineTo { x: 4; y: 15; } LineTo { x: 4; y: 4; } LineTo { x: 15; y: 4; } LineTo { x: 15; y: 6; }
    }

    // Paste (clipboard)
    if name == "paste" : Path {
