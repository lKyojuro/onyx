        QuadraticTo { control-x: 12; control-y: 20; x: 2; y: 12; }
        MoveTo { x: 15; y: 12; }
        ArcTo { x: 9; y: 12; radius-x: 3; radius-y: 3; sweep: true; large-arc: false; }
        ArcTo { x: 15; y: 12; radius-x: 3; radius-y: 3; sweep: true; large-arc: false; }
