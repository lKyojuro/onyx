// Slate surfaces and steel-blue accents sampled from the Onyx folder mark.

export global OnyxTheme {
    in-out property <bool> dark-mode: true;
    in-out property <color> accent-color: #9eafc5;

    // Core surfaces, from window chrome to raised panels.
    out property <color> bg-base: dark-mode ? #101722 : #edf1f6;
    out property <color> bg-chrome: dark-mode ? #141c29 : #e4eaf2;
    out property <color> bg-sidebar: dark-mode ? #182230 : #e8edf4;
    out property <color> bg-surface: dark-mode ? #202a38 : #ffffff;
    out property <color> bg-surface-alt: dark-mode ? #1c2634 : #f5f7fa;
    out property <color> bg-elevated: dark-mode ? #263242 : #ffffff;
    out property <color> bg-hover: dark-mode ? #2c394b : #dfe7f1;
    out property <color> bg-pressed: dark-mode ? #37475c : #cfdae8;
    out property <color> bg-selected: dark-mode ? #35465d : #d5e0ee;
    out property <color> bg-input: dark-mode ? #141e2b : #ffffff;
    out property <color> bg-code: dark-mode ? #131d2b : #eef2f7;
    out property <color> bg-badge: dark-mode ? #2b394b : #dfe7f1;
    out property <color> bg-backdrop: dark-mode ? #0d1520c4 : #202a3870;

    // Borders & dividers
    out property <color> border-subtle: dark-mode ? #334154 : #cbd5e2;
    out property <color> border-sidebar: dark-mode ? #2a384a : #cbd5e2;
    out property <color> border-strong: dark-mode ? #586b83 : #8798ac;
    out property <color> border-specular: dark-mode ? #ffffff12 : #ffffffaa;
    out property <color> border-focus: dark-mode ? accent-color : accent-bright;

    // Typography colors
    out property <color> text-primary: dark-mode ? #eef3f9 : #141c29;
    out property <color> text-secondary: dark-mode ? #c0ccdc : #3f5065;
    out property <color> text-muted: dark-mode ? #a4b3c6 : #516177;
    out property <color> text-on-accent: dark-mode ? #141c29 : #ffffff;

    // Accent & semantic colors
    out property <color> accent-effective: dark-mode ? accent-color : #465c78;
    out property <color> accent-bright: dark-mode ? #b4c2d4 : #3b516d;
    out property <color> accent-subtle: dark-mode ? #9eafc529 : #465c781c;
    out property <color> accent-border: dark-mode ? #9eafc56b : #465c7866;
    out property <color> folder-tint: dark-mode ? #b4c2d4 : #465c78;
    out property <color> file-tint: dark-mode ? #a4b3c6 : #516177;
    out property <color> symlink-tint: dark-mode ? #7cc8ff : #0284c7;
    out property <color> success: dark-mode ? #6ccb5f : #15803d;
    out property <color> warning: dark-mode ? #f4c95d : #d97706;
    out property <color> warning-bg: dark-mode ? #332714d8 : #fef3c7;
    out property <color> warning-text: dark-mode ? #fde68a : #92400e;
    out property <color> danger: dark-mode ? #f06e96 : #dc2626;
    out property <color> danger-bg: dark-mode ? #351626d8 : #fee2e2;
    out property <color> danger-hover: dark-mode ? #e05382 : #b91c1c;

    // Corner radii
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Spacing scale
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;

    // Typography
    in-out property <string> font-family: "Bahnschrift";
    in-out property <string> font-brand: font-family;
    in-out property <string> font-mono: "Cascadia Mono";
    out property <length> font-xs: 12px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 18px;
}
