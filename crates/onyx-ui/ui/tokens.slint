// Onyx Nocturne (Nyx-inspired) & Clean Light Design Tokens
// WCAG contrast ratios (primary / secondary / muted).
// Dark surfaces use white under the window's lightest scrim for a conservative lower bound.
// Theme   bg-surface          bg-sidebar          bg-chrome
// Dark    16.01 / 7.40 / 6.23 12.17 / 5.63 / 4.73 12.24 / 5.66 / 4.76
// Light   18.14 / 8.47 / 5.37 15.94 / 7.45 / 4.72 15.67 / 7.32 / 4.64

export global OnyxTheme {
    in-out property <bool> dark-mode: true;
    in-out property <color> accent-color: #8a7fe8;

    // Core surface hierarchy (translucent midnight-obsidian over cosmic aurora in dark mode)
    out property <color> bg-base: dark-mode ? #000000 : #f4f5fa;
    out property <color> bg-chrome: dark-mode ? #080817b8 : #eceef7;
    out property <color> bg-sidebar: dark-mode ? #090913b8 : #eef0f8;
    out property <color> bg-surface: dark-mode ? #0d0c20ee : #ffffff;
    out property <color> bg-surface-alt: dark-mode ? #0b0a1cd6 : #f8f9fd;
    out property <color> bg-elevated: dark-mode ? #101024f5 : #ffffff;
    out property <color> bg-hover: dark-mode ? #1a1840a8 : #e6e8f4;
    out property <color> bg-pressed: dark-mode ? #242152cc : #dadcf0;
    out property <color> bg-selected: dark-mode ? #1e1b48cc : #e3e0ff;
    out property <color> bg-input: dark-mode ? #12102ae0 : #ffffff;
    out property <color> bg-code: dark-mode ? #08071ae6 : #f5f6fb;
    out property <color> bg-badge: dark-mode ? #17152ee0 : #e7e8f5;
    out property <color> bg-backdrop: dark-mode ? #020208b8 : #0f122466;

    // Borders & dividers
    out property <color> border-subtle: dark-mode ? #1f1f2d : #d6d9e8;
    out property <color> border-sidebar: dark-mode ? #161622 : #d6d9e8;
    out property <color> border-strong: dark-mode ? #343062 : #bcc0d8;
    out property <color> border-specular: dark-mode ? #ffffff12 : #ffffffaa;
    out property <color> border-focus: accent-color;

    // Typography colors
    out property <color> text-primary: dark-mode ? #f1f0ff : #141426;
    out property <color> text-secondary: dark-mode ? #a6a3c0 : #4b4a68;
    out property <color> text-muted: dark-mode ? #9894b7 : #696883;
    out property <color> text-on-accent: dark-mode ? #06061a : #ffffff;

    // Accent & semantic colors
    out property <color> accent-effective: dark-mode ? accent-color : #6256d6;
    out property <color> accent-bright: dark-mode ? #b4aaff : #5447cc;
    out property <color> accent-subtle: dark-mode ? #8a7fe829 : #6256d61a;
    out property <color> accent-border: dark-mode ? #b4aaff48 : #6256d655;
    out property <color> folder-tint: dark-mode ? #b4aaff : #6b5ce7;
    out property <color> file-tint: dark-mode ? #8d89b3 : #646885;
    out property <color> symlink-tint: dark-mode ? #7cc8ff : #0284c7;
    out property <color> success: dark-mode ? #6ccb5f : #15803d;
    out property <color> warning: dark-mode ? #f4c95d : #d97706;
    out property <color> warning-bg: dark-mode ? #332714d8 : #fef3c7;
    out property <color> warning-text: dark-mode ? #fde68a : #92400e;
    out property <color> danger: dark-mode ? #f06e96 : #dc2626;
    out property <color> danger-bg: dark-mode ? #351626d8 : #fee2e2;
    out property <color> danger-hover: dark-mode ? #e05382 : #b91c1c;

    // Corner radii
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Spacing scale
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;

    // Typography
    in-out property <string> font-family: "Segoe UI Variable Text";
    in-out property <string> font-mono: "Cascadia Mono";
    out property <length> font-xs: 12px;
    out property <length> font-sm: 13px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 18px;
}
